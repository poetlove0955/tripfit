      <!-- [🏨 숙소] — 이 비행기 날짜 그대로 그 도시의 숙소를 찾아 준다.
           🛑 [상세보기]가 접혀도 이 단추는 남는다 (펼친 카드에서도 누를 수 있어야 한다) -->
      <div class="살줄">
        <button class="연버튼 살버튼 숙소단추" data-숙소="${i}"
                title="이 날짜에 ${홑(r.목적지)}에서 묵을 곳을 찾아봅니다">숙소 보기</button>
        ${펼침 ? '' : `<button class="연버튼 살버튼" data-펼침="${i}">상세보기 ▾</button>`}
      </div>
