       ${막힌수 ? '<em>⚠</em> 는 못 믿을 값이라 뺀 곳이며, ' : ''}값이 없는 동그라미는 안 물어본 곳입니다.`
    : `<em>어디서 사나요</em> · 위의 값은 <em>네이버 달력값</em>입니다 —
       같은 비행기라도 파는 곳마다 값이 다릅니다. 두세 군데 눌러 보세요.`;
  const 예약 = 파는곳 ? `<div class="살곳">
      <div class="살곳머리">${파는곳말}</div>${파는곳}</div>` : '';

  const 펼침 = (펼친 === i);
  return `<div class="카드">
    <div class="카드머리">
      <div class="카드왼" style="cursor:pointer" data-펼침="${i}">
        <div><span class="도시">${홑(r.목적지)}</span><span class="나라">${홑(r.나라 || '')}</span>${딱지}</div>
        <div class="줄정보">${정보}</div>
      </div>
      <div class="카드오">
        <!-- 🛑 순서를 바꾸지 말 것 — 폰에선 값칸·카드메타가 display:contents 라
             이 DOM 순서 그대로(별·값·값밑·잔줄) 흘러간다. 넓은 화면만 order 로 눕힌다. -->
        <div class="값칸">
          <button class="별${담겼나(r) ? ' 켬' : ''}" data-담기="${i}"
                  title="담으면 콘텐츠에 들어갑니다">${담겼나(r) ? '★' : '☆'}</button>
          <span class="값">${돈(보일값(r))}원</span>
          <div class="값밑">1인 ${r.오는날 ? '왕복' : '편도'}</div>
        </div>
        <div class="카드메타">${평소}${자리}${아낌}${확인줄}</div>
