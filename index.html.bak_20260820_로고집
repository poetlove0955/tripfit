<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>TripFit — 지금 진짜 싼 항공권·숙소, 1년치 값으로 확인하고 알려드립니다</title>
<style>
/* 색은 창 프로그램(트립핏_디자인.py)에서 그대로 가져왔다 — 같은 프로그램으로 보여야 한다 */
:root{
  --배경:#eef2f4; --카드:#fff; --테두리:#e2e9eb; --진테두리:#cfdadd;
  --글자:#0f1416; --보조:#5f7075; --연보조:#8b989c;
  --브랜드:#0d697c; --브랜드밝:#2bbfc0; --브랜드연:#e6f4f6;
  --초록:#1e8449; --빨강:#c0392b; --금:#b7791f; --줄무늬:#f7fafb;
  --옆폭:300px;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  background:var(--배경); color:var(--글자);
  font-family:"Pretendard","맑은 고딕","Malgun Gothic",system-ui,-apple-system,sans-serif;
  font-size:15px; line-height:1.5; -webkit-text-size-adjust:100%;
}
button{font-family:inherit; cursor:pointer}
a{color:inherit}

/* ───────────────────────────────────────────── 위쪽 바 */
.머리{background:var(--카드); border-bottom:1px solid var(--테두리); position:sticky; top:0; z-index:30}
.머리안{display:flex; align-items:center; gap:14px; padding:10px 16px; flex-wrap:wrap}
.로고{display:flex; align-items:center; gap:7px; font-size:20px; font-weight:800;
      color:var(--브랜드); letter-spacing:-.5px; white-space:nowrap}
.로고 em{font-style:normal; color:var(--브랜드밝)}
.탭줄{display:flex; gap:4px; flex:1; min-width:0; overflow-x:auto; scrollbar-width:none}
.탭줄::-webkit-scrollbar{display:none}
.탭{border:1px solid transparent; background:none; color:var(--보조);
    padding:8px 14px; border-radius:9px; font-size:14px; font-weight:600; white-space:nowrap}
.탭:hover{background:var(--줄무늬)}
.탭.켬{background:var(--브랜드연); color:var(--브랜드); border-color:#bfe3e8}
.머리단추{display:flex; gap:7px; flex-shrink:0}
.연버튼{background:var(--카드); border:1px solid var(--진테두리); color:var(--보조);
        padding:7px 12px; border-radius:8px; font-size:13px; font-weight:600}
.연버튼:hover{border-color:var(--브랜드밝); color:var(--브랜드)}

/* ───────────────────────────────────────────── 판 */
.판{display:flex; align-items:flex-start; gap:0; min-height:calc(100vh - 56px)}
.옆{width:var(--옆폭); flex:0 0 var(--옆폭); background:var(--카드);
    border-right:1px solid var(--테두리); align-self:stretch;
    position:sticky; top:56px; height:calc(100vh - 56px); display:flex; flex-direction:column}
.옆속{flex:1; overflow-y:auto; padding:16px}
.옆밑{border-top:1px solid var(--테두리); padding:12px 16px}
.본{flex:1; min-width:0; padding:12px 16px 40px}

.쪽제목{font-size:12px; color:var(--연보조); margin:16px 0 6px}
.쪽제목:first-child{margin-top:0}

.접머리{cursor:pointer; user-select:none}
.접머리 b{color:var(--브랜드); font-size:14px}
.접머리 span{display:block; color:var(--연보조); font-size:12px; margin-top:3px; white-space:pre-line}

select,input[type=text],input[type=number],input[type=date],input[type=password]{
  width:100%; padding:9px 10px; border:1px solid var(--진테두리); border-radius:8px;
  font-size:14px; font-family:inherit; background:#fff; color:var(--글자)}
select:focus,input:focus{outline:2px solid var(--브랜드밝); outline-offset:-1px}

.칩줄{display:flex; flex-wrap:wrap; gap:6px}
.칩{border:1px solid var(--진테두리); background:#fff; color:var(--보조);
    padding:7px 11px; border-radius:20px; font-size:13px; font-weight:600; white-space:nowrap}
.칩.켬{background:var(--브랜드연); border-color:var(--브랜드밝); color:var(--브랜드)}
.세로칩{width:100%; text-align:left; border:none; background:none;
        padding:8px 10px; border-radius:8px; color:var(--보조); font-size:14px;
        display:flex; justify-content:space-between; align-items:center; gap:8px}
.세로칩:hover{background:var(--줄무늬)}
.세로칩.켬{background:var(--브랜드연); color:var(--브랜드); font-weight:700;
           box-shadow:inset 3px 0 0 var(--브랜드)}
.세로칩 i{font-style:normal; font-size:12px; color:var(--연보조)}

/* '찾은 곳' — 좁은 화면에선 한 번 쫙 펴 보여준 뒤 저 혼자 접힌다 (자리를 너무 먹는다) */
.지역머리{display:flex; align-items:center; gap:8px}
.지역요약,.지역화살{display:none}
.지역감{overflow:hidden; transition:max-height .4s ease, opacity .3s ease}

.큰버튼{width:100%; background:var(--브랜드); color:#fff; border:none; border-radius:10px;
        padding:14px; font-size:16px; font-weight:700; letter-spacing:-.3px}
.큰버튼:hover{background:#0a5666}
.큰버튼:disabled{background:#9ab6bc; cursor:default}
.체크{display:flex; align-items:center; gap:8px; padding:6px 0; font-size:14px; color:var(--보조); cursor:pointer}
.체크 input{width:16px; height:16px; accent-color:var(--브랜드)}

/* ───────────────────────────────────────────── 결과 */
.상태줄{display:flex; align-items:center; gap:10px; flex-wrap:wrap;
        color:var(--보조); font-size:13px; padding:4px 4px 10px}
.막대{height:3px; background:var(--테두리); border-radius:2px; overflow:hidden; width:100%; margin-bottom:10px}
.막대 i{display:block; height:100%; background:var(--브랜드밝); width:0; transition:width .3s}
.막대.흐름 i{width:35%; animation:흐름 1.1s ease-in-out infinite}
@keyframes 흐름{0%{margin-left:-35%}100%{margin-left:100%}}

.도구{background:var(--카드); border:1px solid var(--테두리); border-radius:12px;
      padding:12px 14px; display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:12px}
.결과글{font-size:19px; font-weight:800; margin-right:6px}

.카드{background:var(--카드); border:1px solid var(--테두리); border-radius:12px;
      padding:16px 18px; margin-bottom:10px}
.카드머리{display:flex; align-items:flex-start; gap:12px; flex-wrap:wrap}
.카드왼{flex:1; min-width:0}
.도시{font-size:21px; font-weight:800; letter-spacing:-.5px}
.나라{font-size:12px; color:var(--연보조); margin-left:7px; font-weight:500}
.딱지{display:inline-block; padding:3px 9px; border-radius:20px; font-size:12px;
      font-weight:700; margin-left:8px; vertical-align:3px}
.딱지.특가{background:#fdecea; color:#b32d1f}
.딱지.싼{background:var(--브랜드연); color:var(--브랜드)}
.딱지.법{background:#f2f6f7; color:var(--보조)}
.줄정보{color:var(--보조); font-size:14px; margin-top:7px}
.카드오{text-align:right; flex-shrink:0}
.값{font-size:24px; font-weight:800; color:var(--브랜드); letter-spacing:-.6px; white-space:nowrap}
.값밑{font-size:12px; color:var(--연보조); margin-top:2px}
.평소{font-size:12px; color:var(--연보조); margin-top:3px}
.평소 s{margin-right:5px}
.평소 b{color:var(--빨강)}
/* 값칸·카드메타 = 넓은 화면에서만 쓰는 묶음.
   여기선 display:contents 라 **없는 것처럼** 흘러간다 → 폰 화면은 예전 그대로다. */
.값칸,.카드메타{display:contents}
/* 이 값이 진짜인가 — 실제로 파는 곳에 물어본 결과 */
.확인{font-size:12px; margin-top:6px; padding:5px 8px; border-radius:7px; line-height:1.45;
      font-weight:600; max-width:340px}
.확인.좋{background:#e8f6ee; color:#1c7a4a}
.확인.갸웃{background:#fdf4e3; color:#8a5a12}
.확인.나쁨{background:#fdecea; color:#b32d1f}
.확인.아직{background:none; color:var(--연보조); font-weight:500; padding:2px 0}
.별{background:none; border:none; font-size:20px; color:var(--연보조); padding:0 4px; line-height:1}
.별.켬{color:var(--금)}
/* [🏨 숙소] [상세보기] — 넓은 화면에선 아랫줄 오른쪽, 좁은 화면에선 값 옆으로 올라붙는다.
   단추가 둘이 됐으니 자리는 flex 가 잡는다 (예전엔 text-align 하나로 됐다). */
.살줄{flex:0 0 100%; margin-top:4px;
      display:flex; gap:6px; justify-content:flex-end; flex-wrap:wrap}
.살버튼{padding:5px 11px; font-size:13px; white-space:nowrap}
.숙소단추{border-color:#bfe3e8; color:var(--브랜드); background:var(--브랜드연)}
.숙소단추:hover{background:var(--브랜드); border-color:var(--브랜드); color:#fff}

/* 어디서 사나요 — 여섯 군데를 **같은 크기로** 늘어놓는다.
   예전엔 네이버만 진한 색이라 '여기가 제일 싸다'로 읽혔다. 실제론 카약이 더 쌀 때가 있다.
   그래서 색은 **점 하나로만** 내고, 값이 어디서 온 값인지는 [이 값] 딱지로 밝힌다. */
.살곳{margin-top:12px; padding-top:11px; border-top:1px dashed var(--테두리)}
.살곳머리{font-size:12px; color:var(--연보조); margin-bottom:8px; line-height:1.5}
.살곳머리 em{font-style:normal; color:var(--보조); font-weight:700}
/* 단추는 **앞글자 한 자**만 (스 트 키 네 구 카 직). 여섯 칸이 한 줄에 들어가고,
   카드가 안 커진다. 어디인지는 동그라미 색 + 손 올리면 뜨는 이름으로 안다.
   값을 물어본 곳만 옆에 값이 붙으니, 붙은 쪽이 곧 '실제로 확인한 곳'이다. */
.예약{display:flex; flex-wrap:wrap; gap:6px}
.예약 a{display:inline-flex; align-items:center; gap:5px; text-decoration:none;
        background:#fff; border:1px solid var(--진테두리); border-radius:999px;
        padding:3px 9px 3px 3px; color:var(--보조);
        transition:border-color .15s, box-shadow .15s, transform .1s}
.예약 a.민{padding:3px}                     /* 값이 없는 곳은 동그라미 하나 — 제일 작다 */
.예약 a:hover{border-color:var(--점,var(--브랜드밝)); color:var(--글자);
              box-shadow:0 2px 8px rgba(11,90,107,.13); transform:translateY(-1px)}
.예약 a i{width:22px; height:22px; border-radius:50%; flex:none; font-style:normal;
          display:flex; align-items:center; justify-content:center;
          font-size:12px; font-weight:800; color:#fff; background:var(--점,#9aa7ab)}
.예약 a b{font-size:11px; font-weight:800; letter-spacing:-.3px; color:var(--보조)}
/* 제일 싼 곳 — 테두리째 브랜드색으로 (값딱만 칠하면 눈에 안 들어왔다) */
.예약 a.싼곳{border-color:var(--브랜드); background:var(--브랜드연)}
.예약 a.싼곳 b{color:var(--브랜드)}
/* 🛑 네이버 달력값은 **물어본 값이 아니다.** 그렇다고 안 보여주면 화면이 거짓말을
   한다 — 카드값이 원래 여기서 나왔는데 "안 물어본 곳"이라고 적히기 때문이다
   (8/11 요나고에서 대표가 잡아낸 자리). 그래서 값은 보여주되 **흐리고 점선으로**
   구분한다. 확인한 값과 같은 굵기로 쓰면 그게 또 거짓말이다. */
.예약 a.달력{border-style:dashed}
.예약 a b.달력값{color:var(--연보조); font-weight:700}
/* 못 믿을 값이라 뺀 곳 — 빈 동그라미(안 물어봄)와 반드시 달라 보여야 한다 */
.예약 a.막힘{border-color:#e8b4b4; background:#fff7f7}
.예약 a b.막힘딱{color:#c0392b}
.구간표{font-size:12px; color:var(--보조); font-weight:700; margin:10px 0 6px}
.구간표:first-child{margin-top:0}

.빈{text-align:center; padding:70px 20px; color:var(--연보조)}
.빈 .큰{font-size:54px; color:#dce6e8; line-height:1}
/* 🛑 첫 화면의 빈 칸은 **짧아야 한다.** 폰에서 재 보니 이것이 231px 을 먹어
   바로 밑의 [🧳 내 여행 계획] 을 화면 밖(y=743, 창은 812)으로 밀어냈다.
   할 말은 위의 계획 칸이 이미 하고 있으니, 여기는 한 줄이면 된다. */
.빈.첫{padding:26px 20px}
.빈.첫 .큰{font-size:34px}
.빈.첫 div{margin-top:8px !important; font-size:14px}
.밑줄{display:flex; align-items:center; gap:8px; flex-wrap:wrap; justify-content:flex-end;
      background:var(--카드); border:1px solid var(--테두리); border-radius:12px;
      padding:12px 14px; margin-top:14px}
.밑줄 .말{flex:1; min-width:180px; font-size:13px; color:var(--연보조); text-align:left}
.밑줄 .말.켬{color:var(--브랜드); font-weight:600}

/* ─────────────────── 찾는 동안만 나오는 칸 (다 찾으면 저 혼자 사라진다)
   예전엔 여기 검은 로그창이 그대로 있었다. 훑은 줄이 수십 개씩 쌓여서
   손님 눈엔 '고장난 화면'으로 보였다 — 그래서 **한 번에 한 마디**만 남겼다. */
.비행{background:var(--카드); border:1px solid var(--테두리); border-radius:14px;
      padding:20px 24px 16px; margin-bottom:12px; text-align:center;
      transition:opacity .45s ease, transform .45s ease}
.비행.사라짐{opacity:0; transform:translateY(-8px)}
.하늘{position:relative; height:56px; margin-bottom:4px; overflow:hidden}
.하늘 .길{position:absolute; left:0; right:0; top:50%; border-top:2px dashed #d9e8eb}
.비행기{position:absolute; top:50%; font-size:26px; line-height:1;
        animation:날기 3s cubic-bezier(.45,0,.55,1) infinite}
@keyframes 날기{
  0%  {left:-9%;  transform:translateY(-50%) rotate(-8deg)}
  45% {           transform:translateY(-92%) rotate(4deg)}
  100%{left:105%; transform:translateY(-50%) rotate(-8deg)}
}
.구름{position:absolute; color:#eaf3f5; animation:흘러 7s linear infinite}
.구름1{top:2px;  font-size:22px; animation-duration:6s}
.구름2{top:32px; font-size:16px; animation-duration:9.5s; animation-delay:-3s}
.구름3{top:12px; font-size:30px; animation-duration:13s; animation-delay:-7s}
@keyframes 흘러{0%{left:106%}100%{left:-16%}}
.비행 .말{font-size:18px; font-weight:800; letter-spacing:-.4px; color:var(--브랜드)}
.비행 .곁말{font-size:13px; color:var(--연보조); margin-top:6px; min-height:19px}
.비행 .막대{margin:14px auto 0; max-width:430px}
.비행 .진행글{margin-top:9px; font-size:12px; color:var(--연보조);
              display:flex; gap:12px; justify-content:center; align-items:center}
.진행자세히{background:none; border:none; color:var(--연보조); font-size:12px;
            text-decoration:underline; padding:0}
.진행자세히:hover{color:var(--브랜드)}
.로그{background:#0f1416; color:#9fd8de; font-family:Consolas,monospace; font-size:11px;
      border-radius:10px; padding:10px 12px; max-height:150px; overflow:auto;
      white-space:pre-wrap; text-align:left; margin:12px 0 0}
/* 움직임이 불편한 사람에겐 안 흔든다 */
@media (prefers-reduced-motion: reduce){
  .비행기,.구름{animation:none}
  .지역감{transition:none}
  .비행기{left:46%; transform:translateY(-50%)}
}

/* ─────────────────────────────────────────────── 🏨 숙박
   항공 카드와 **같은 뼈대**(.카드)를 쓰되, 숙박은 봐야 할 게 다르다:
   값 하나가 아니라 [값 · 후기 · 위치] 세 가지를 한눈에 재야 한다.
   그래서 왼쪽에 사진, 가운데에 세 줄, 오른쪽에 값 — 이 배치가 굳어 있다. */
.숙카드{display:flex; gap:13px; align-items:flex-start}
.숙사진{width:96px; height:96px; flex:none; border-radius:10px; object-fit:cover;
        background:var(--줄무늬); border:1px solid var(--테두리)}
.숙사진.빔{display:flex; align-items:center; justify-content:center;
           font-size:26px; color:#cfdcdf}
.숙속{flex:1; min-width:0}
.숙이름{font-size:17px; font-weight:800; letter-spacing:-.3px; line-height:1.3;
        display:block; color:var(--글자); text-decoration:none}
.숙이름:hover{color:var(--브랜드); text-decoration:underline}
.숙줄{font-size:13px; color:var(--보조); margin-top:5px; display:flex;
      flex-wrap:wrap; gap:4px 10px; align-items:center}
/* 🛑 가까운 역 이름이 'Jinshan Passenger Transport Station' 처럼 길 때가 있다.
   nowrap 만 걸어 두면 그 한 줄이 폰 화면을 통째로 밀어 가로 스크롤을 만든다. */
.숙줄 .조각{white-space:nowrap; max-width:100%; min-width:0;
            overflow:hidden; text-overflow:ellipsis}
.후기알{background:var(--브랜드); color:#fff; font-weight:800; font-size:12px;
        padding:2px 7px; border-radius:6px}
.후기알.낮{background:#9aa7ab}
.후기알.없{background:none; color:var(--연보조); font-weight:600; padding:2px 0}
.숙값칸{flex:none; text-align:right; min-width:126px}
.숙값{font-size:21px; font-weight:800; color:var(--브랜드); letter-spacing:-.5px;
      white-space:nowrap}
.숙값밑{font-size:11px; color:var(--연보조); margin-top:2px; line-height:1.5}
.숙값밑 b{color:var(--보조)}
/* 가성비 막대 — 숫자만 던지면 90 이 좋은 건지 나쁜 건지 모른다. 길이로 같이 보여준다 */
.가성비줄{display:flex; align-items:center; gap:8px; margin-top:8px}
.가성비막대{flex:1; max-width:170px; height:6px; border-radius:4px;
            background:var(--줄무늬); overflow:hidden}
.가성비막대 i{display:block; height:100%; background:linear-gradient(90deg,#2bbfc0,#0d697c)}
.가성비글{font-size:12px; color:var(--연보조); font-weight:700; white-space:nowrap}
.가성비글 b{color:var(--브랜드); font-size:13px}
.숙딱지줄{display:flex; flex-wrap:wrap; gap:5px; margin-top:7px}
.딱지.좋{background:#e8f6ee; color:#1c7a4a}
.딱지.흐림{background:var(--줄무늬); color:var(--연보조)}
.숙단추줄{display:flex; gap:6px; justify-content:flex-end; margin-top:9px; flex-wrap:wrap}
/* 항공 카드에서 [🏨 숙소] 로 넘어왔을 때 위에 붙는 띠 */
.넘어옴{background:var(--브랜드연); border:1px solid #bfe3e8; border-radius:12px;
        padding:11px 14px; margin-bottom:12px; font-size:14px; color:var(--브랜드);
        display:flex; gap:10px; align-items:center; flex-wrap:wrap}
.넘어옴 b{font-weight:800}
.넘어옴 .되돌기{margin-left:auto}
@media (max-width:560px){
  .숙카드{gap:10px}
  .숙사진{width:70px; height:70px}
  .숙값칸{min-width:96px}
  .숙값{font-size:18px}
}

/* 💎 Trip Fit 추천 — 등급 넷을 색으로 가른다.
   🛑 넷을 다 같은 색으로 칠하면 '추천' 이라는 말만 남고 순위가 안 보인다.
      1순위만 눈에 띄게 진하고, 아래로 갈수록 옅어진다. */
.추천딱{display:inline-flex; align-items:center; gap:4px; font-size:11px; font-weight:800;
        padding:2px 8px; border-radius:20px; white-space:nowrap}
.추천딱.급1{background:#0d697c; color:#fff}
.추천딱.급2{background:#dff3f5; color:#0b5a6b}
.추천딱.급3{background:#eef4ec; color:#3f6b45}
.추천딱.급4{background:var(--줄무늬); color:var(--보조)}
.추천말{font-size:12px; color:var(--연보조); margin-top:5px; line-height:1.45}
.추천말 b{color:var(--브랜드); font-weight:800}
/* 1순위 카드는 테두리로도 티를 낸다 — 목록을 훑다 눈이 먼저 걸려야 하는 자리다 */
.카드.으뜸{border-color:#0d697c; box-shadow:0 2px 12px rgba(13,105,124,.13)}
/* 기본 정렬이자 이 탭이 내세우는 자 — 칩 하나만 테두리로 티를 낸다 */
.칩.추천칩{border-color:#9ed3da; color:var(--브랜드); font-weight:800}
.칩.추천칩.켬{border-color:var(--브랜드)}
.추천머리{grid-column:1 / -1; display:flex; align-items:center; gap:8px;
          margin:12px 0 7px; font-size:13px; font-weight:800; color:var(--브랜드)}
.추천머리:first-child{margin-top:0}
.추천머리 i{flex:1; height:1px; background:var(--테두리); font-style:normal}
.추천머리 span{font-weight:600; color:var(--연보조); font-size:12px}

/* 어느 집에서 온 값인가 · 두 집 값을 견줘 봤나 */
.곳딱{font-size:11px; font-weight:700; color:var(--연보조);
      background:var(--줄무늬); padding:2px 7px; border-radius:5px}
.견줌{font-size:11.5px; color:var(--보조); margin-top:5px; line-height:1.5}
.견줌 b{color:#1c7a4a; font-weight:800}
.견줌 s{color:var(--연보조)}

/* 종류 칩의 [✕] = 빼기. 고르기(칩 몸통)와 빼기(✕)가 한 칩에 같이 산다 */
.칩.뺀{text-decoration:line-through; opacity:.55}
.칩 .엑스{margin-left:6px; padding:0 3px; border-radius:4px; font-weight:800;
          color:var(--연보조); font-size:11px}
.칩 .엑스:hover{background:#fde8e8; color:var(--빨강)}
.뺀줄{display:flex; align-items:center; gap:6px; flex-wrap:wrap; font-size:12px;
      color:var(--연보조); margin-top:8px}
.뺀줄 b{color:var(--빨강); font-weight:700}

/* 🏨 숙소 목록도 넓은 화면에서는 **두 칸**으로 깐다 (항공 #목록 과 같은 생각).
   숙소 카드는 [사진|속|값] 세 덩어리라 470px 밑으로 내려가면 값칸이 눌린다 —
   그래서 최소폭을 470px 로 두고, 그게 안 나오면 저 혼자 한 칸으로 돌아간다. */
@media (min-width:901px){
  #숙목록{display:grid; grid-template-columns:repeat(auto-fill,minmax(470px,1fr));
          gap:0 10px; align-items:start}
  #숙목록 > *:not(.카드){grid-column:1 / -1}
  #숙목록 .카드{margin-bottom:8px}
  /* 두 칸일 땐 사진을 조금 줄여 이름이 두 줄로 접히지 않게 한다 */
  #숙목록 .카드{container-type:inline-size}
}
@container (max-width:560px){
  .숙사진{width:78px; height:78px}
  .숙이름{font-size:15.5px}
  .숙값{font-size:19px}
  .숙값칸{min-width:112px}
  .가성비막대{max-width:110px}
}

/* ───────────────────────────────────────────── 준비중 · 모달 */
.준비{background:var(--카드); border:1px solid var(--테두리); border-radius:14px; padding:36px}
.준비 h2{margin:0; font-size:22px}
.준비 p{color:var(--보조); margin:8px 0 0}
.준비 .뱃지{display:inline-block; background:var(--브랜드연); color:var(--브랜드);
            padding:4px 10px; border-radius:20px; font-size:12px; font-weight:700; margin:16px 0 18px}
.준비 li{margin:5px 0}
.준비 hr{border:none; border-top:1px solid var(--테두리); margin:22px 0 14px}
.준비 .끝{color:var(--보조); font-size:14px}

.덮개{position:fixed; inset:0; background:rgba(15,20,22,.5); z-index:50;
      display:none; align-items:center; justify-content:center; padding:16px}
.덮개.켬{display:flex}
.상자{background:var(--카드); border-radius:14px; width:min(980px,100%);
      max-height:92vh; display:flex; flex-direction:column; overflow:hidden}
.상자머리{display:flex; align-items:center; gap:10px; padding:14px 18px; border-bottom:1px solid var(--테두리)}
.상자머리 b{flex:1; font-size:17px}
.상자속{padding:16px 18px; overflow:auto; flex:1}
.상자밑{padding:12px 18px; border-top:1px solid var(--테두리); display:flex; gap:8px;
        align-items:center; flex-wrap:wrap}
.닫기{background:none; border:none; font-size:22px; color:var(--연보조); line-height:1}

/* 나라 머리 — 도시를 하나씩 열두 번 누르지 않게 [＋ 전부] 를 여기 둔다 */
.곳머리{display:flex; align-items:center; gap:8px; margin:18px 0 8px}
.곳머리:first-child{margin-top:0}
.곳머리 b{font-size:14px; font-weight:800; color:var(--글자)}
.곳머리 .곳수{flex:1; font-size:12px; color:var(--연보조); font-weight:600}
.지역단추{border:1px solid var(--진테두리); background:#fff; color:var(--보조);
          padding:5px 12px; border-radius:20px; font-size:12px; font-weight:700; white-space:nowrap}
.지역단추:hover{border-color:var(--브랜드밝); color:var(--브랜드)}
.지역단추.켬{background:var(--브랜드); border-color:var(--브랜드); color:#fff}
.곳고르기{display:grid; grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); gap:6px}
.곳{display:flex; align-items:center; gap:7px; padding:7px 9px; border-radius:8px;
    border:1px solid var(--테두리); font-size:14px; cursor:pointer; background:#fff}
.곳.켬{background:var(--브랜드연); border-color:var(--브랜드밝); color:var(--브랜드); font-weight:700}

/* ─────────────────── 여행객 (몇 명 · 몇 살 · 어떤 자리)
   <select> 두 개로는 **나이를 물을 자리가 없다**. 창 하나로 빼서
   어른·유소아를 ＋－ 로 세고, 유소아는 몇 살인지까지 받는다
   (만 2세 미만은 요금 체계가 아예 다르다 — 예약 화면이 그걸 알아야 한다). */
.사람단추{width:100%; text-align:left; padding:10px 12px; font-size:14px}
.사람줄{display:flex; align-items:center; gap:12px; padding:14px 2px;
        border-top:1px solid var(--테두리)}
.사람줄.첫{border-top:none; padding-top:4px}
.사람글{flex:1; min-width:0}
.사람글 b{display:block; font-size:15px; font-weight:800}
.사람글 span{display:block; font-size:12px; color:var(--연보조); margin-top:2px}
.셈{display:flex; align-items:center; gap:12px; flex:none}
.셈 button{width:38px; height:38px; border-radius:10px; border:1px solid var(--진테두리);
           background:#fff; font-size:19px; font-weight:700; color:var(--글자); line-height:1}
.셈 button:hover:not(:disabled){border-color:var(--브랜드밝); color:var(--브랜드)}
.셈 button:disabled{color:#c9d2d4; background:var(--배경); border-color:var(--테두리);
                    cursor:default}
.셈 b{min-width:18px; text-align:center; font-size:16px; font-weight:800}
.나이칸{background:var(--배경); border-radius:11px; padding:12px; margin:2px 0 4px}
.나이줄{display:flex; align-items:center; gap:10px; margin-top:8px}
.나이줄:first-child{margin-top:0}
.나이줄 span{flex:1; font-size:13px; color:var(--보조); font-weight:600}
.나이줄 select{width:auto; flex:none; min-width:132px; padding:7px 9px}
.사람말{color:var(--연보조); font-size:12px; line-height:1.6; margin:14px 0 0}

/* ─────────────────── 달력 (가는 날·오는 날을 한 번에)
   폰에서 input[type=date] 두 개는 달력이 두 번 뜬다. 한 번에 끝내려고 직접 그린다. */
.날짜단추{width:100%; text-align:left; padding:10px 12px; font-size:14px}

/* 고른 날짜 — 달력 위에 붙박이 (달력을 내려도 늘 보인다) */
.달머리{display:flex; align-items:stretch; gap:8px; padding:12px 18px 10px}
.달칸{flex:1; min-width:0; border:1.5px solid var(--진테두리); border-radius:11px;
      padding:8px 11px; background:#fff; transition:border-color .15s, background .15s}
.달칸.차례{border-color:var(--브랜드); background:var(--브랜드연)}
.달칸 span{display:block; font-size:11px; color:var(--연보조); font-weight:600}
.달칸 b{display:block; font-size:15px; font-weight:800; letter-spacing:-.3px;
        color:var(--글자); margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
.달칸.빔 b{color:var(--연보조); font-weight:600}
.달사이{display:flex; align-items:center; justify-content:center; flex:none; width:52px}
.달사이 i{font-style:normal; font-size:12px; font-weight:800; color:var(--브랜드);
          background:var(--브랜드연); border-radius:20px; padding:3px 9px; white-space:nowrap}
.달요일{padding:6px 18px 0; border-top:1px solid var(--테두리)}

.달{margin-bottom:18px}
.달이름{font-size:14px; font-weight:800; text-align:center; margin-bottom:9px}
.요일,.날들{display:grid; grid-template-columns:repeat(7,1fr); gap:2px}
.요일 span{text-align:center; font-size:11px; color:var(--연보조); padding-bottom:5px}
.요일 span:first-child{color:#d0555b}
.날들 button{aspect-ratio:1/1; border:none; background:none; border-radius:10px;
             font-size:14px; font-weight:600; color:var(--글자); padding:0}
.날들 button:disabled{color:#d3dcde}
.날들 button:not(:disabled):hover{background:var(--줄무늬)}
.날들 .사이{background:var(--브랜드연); border-radius:0; color:var(--브랜드)}
.날들 .시,.날들 .끝{background:var(--브랜드); color:#fff}
.날들 .시{border-radius:10px 0 0 10px}
.날들 .끝{border-radius:0 10px 10px 0}
.날들 .시.홀,.날들 .시.끝{border-radius:10px}

.알림{padding:9px 12px; border-radius:8px; font-size:13px; margin-bottom:10px; display:none}
.알림.좋{background:#e8f6ee; color:#1c7a4a; display:block}
.알림.나쁨{background:#fdecea; color:#b32d1f; display:block; white-space:pre-wrap}

/* ───────────────────────────────────────────── 넓은 화면 (PC) — 8/10 개편
   예전엔 카드 한 장이 일곱 줄이었다. 도시·날짜는 왼쪽 끝, 값과 잔줄(평소·백분위·확인)은
   오른쪽 끝에 세로로 쌓여서 **가운데가 통째로 비고** 한 화면에 세 장밖에 안 들어갔다.
   그래서 오른쪽에 쌓여 있던 잔줄을 그 빈 가운데로 눕히고, 화면이 넓으면 **두 칸으로 깐다**.
     1칸(≤1540px) : 한 줄짜리 납작한 카드 75px
     2칸(1560px~) : 두 줄짜리 카드 105px × 두 개  → 1900px 에서 한 화면 12장 (예전 3장)
   값칸은 폭을 고정해서 값이 아래로 쭉 한 줄에 맞춰진다 (눈으로 훑을 때 이게 제일 크다).
   🛑 이 블록은 901px 이상에서만 돈다 — 폰(≤900px)은 한 줄도 안 건드렸다.
      옛 구조/새 구조를 나란히 그려 요소 33개의 좌표를 대 봤고 **다른 곳 0개**였다. */
@media (min-width:901px){
  /* 화면이 넓으면 카드를 두 칸으로 깐다 — 600px 이 안 나오면 저 혼자 한 칸으로 돌아간다.
     [＋더 보기]·[빈 화면] 같은 카드 아닌 것들은 칸을 가로질러 통째로 눕힌다. */
  #목록{display:grid; grid-template-columns:repeat(auto-fill,minmax(600px,1fr));
        gap:0 10px; align-items:start}
  #목록 > *:not(.카드){grid-column:1 / -1}

  /* 🛑 카드는 **자기 폭**을 보고 배치를 고른다 (화면 폭이 아니라).
     1칸이면 넓으니 한 줄, 2칸이면 좁으니 두 줄 — 아래 @container 가 그 갈림길이다. */
  .카드{padding:11px 14px 11px 16px; margin-bottom:7px; container-type:inline-size}
  .카드머리{align-items:center; gap:6px 14px}

  /* 도시·날짜 쪽을 조금 더 넓게 가져간다 — 좁으면 제목이 두 줄로 접혀 카드가 도로 커진다 */
  .카드왼{flex:1.35 1 260px}
  .도시{font-size:18px}
  .나라{margin-left:6px}
  .딱지{font-size:11px; padding:2px 8px; margin-left:6px; vertical-align:2px}
  .줄정보{font-size:13px; margin-top:3px}

  /* 오른쪽 덩어리 = [잔줄들] [값] 이 나란히 눕는다 */
  .카드오{display:flex; align-items:center; justify-content:flex-end;
          flex:1 1 380px; min-width:0; gap:14px}
  .카드메타{display:flex; order:1; flex:1 1 auto; min-width:0;
            flex-wrap:wrap; align-items:center; justify-content:flex-end;
            gap:2px 9px; text-align:left}
  .카드메타 .평소{margin-top:0; white-space:nowrap}
  .카드메타 .확인{margin-top:0; max-width:none; padding:3px 8px}
  .카드메타 .확인.아직{padding:3px 0}

  .값칸{display:block; order:2; flex:none; width:172px}
  .값{font-size:21px}
  .값밑{margin-top:1px}
  .별{font-size:18px; vertical-align:-1px}

  /* [상세보기] 도 같은 줄로 — 예전엔 이것 하나 때문에 줄이 통째로 하나 더 있었다.
     단추 둘을 세로로 쌓아 폭을 안 늘린다 (넓은 화면에선 오른쪽 칸이 좁다) */
  .살줄{flex:0 0 auto; width:98px; margin-top:0; flex-direction:column; align-items:flex-end}
  .살버튼{padding:4px 9px; font-size:12px}
  .살곳{margin-top:10px; padding-top:9px}

  /* ── 카드가 좁을 때(=2칸으로 깔렸을 때) — 한 줄로는 안 되니 두 줄로 접는다
        [도시 · 딱지        ]  [★ 123,247원]
        [날짜 · 직항 · 항공사]  [   1인 왕복 ]
        [평소 · 싼날 · 확인줄]  [   상세보기 ]   ← 오른쪽 칸은 값·단추가 같은 선에 선다
     🛑 @container 를 못 알아듣는 브라우저는 이 블록을 통째로 건너뛰고 위의 한 줄 배치로 간다
        (좁아서 답답할 뿐, 깨지지는 않는다). */
  @container (max-width:780px){
    .카드머리{display:grid; align-items:center; gap:5px 12px;
              grid-template-columns:minmax(0,1fr) auto;
              grid-template-areas:"왼 값" "메타 살"}
    .카드오{display:contents}              /* 값칸·카드메타를 격자에 직접 놓는다 */
    .카드왼{grid-area:왼}
    .값칸{grid-area:값; text-align:right}
    .카드메타{grid-area:메타; justify-content:flex-start; gap:2px 8px}
    .살줄{grid-area:살; align-self:center; width:auto; justify-self:end;
          flex-direction:row}
    .도시{font-size:17px}
    .값{font-size:20px}
  }
}

/* ───────────────────────────────────────────── 좁은 화면 */
@media (max-width:900px){
  .판{display:block}
  .옆{width:auto; flex:none; position:static; height:auto; border-right:none;
      border-bottom:1px solid var(--테두리)}
  .옆속{max-height:none; overflow:visible}
  .옆밑{position:sticky; bottom:0; background:var(--카드); z-index:20}
  .본{padding:12px}

  /* 찾은 곳 — 접는 머리를 꺼낸다 */
  .지역머리{cursor:pointer; user-select:none; padding:2px 0}
  .지역요약{display:block; flex:1; font-size:13px; font-weight:700; color:var(--브랜드)}
  .지역화살{display:block; color:var(--연보조); font-size:12px}
  .지역감.접힘{opacity:0}

  /* 카드는 최대한 낮게 — [상세보기]를 값 줄 오른쪽 끝으로 올려 한 줄을 통째로 줄인다 */
  .카드{padding:12px 14px; margin-bottom:8px}
  .카드머리{flex-wrap:wrap; gap:8px}
  .카드왼{flex:1 0 100%; min-width:100%}
  .카드오{text-align:left; width:auto; flex:1 1 auto; min-width:0}
  .살줄{flex:0 0 auto; margin:0 0 0 auto; align-self:flex-end; justify-content:flex-end}
  .도시{font-size:19px}
  .딱지{margin-left:6px; padding:2px 8px}
  .줄정보{font-size:13px; margin-top:5px}
  .값{font-size:22px}
  .평소{margin-top:2px}
  .예약{grid-template-columns:repeat(2,1fr)}   /* 폰에선 딱 두 줄로 — 들쭉날쭉이 없다 */
}

/* ══════════════════════════════════════════════════════════════════════
   2026-08-19 · 첫 화면 개편 — "묻는 것은 넷, 나머지는 접어 둔다"

   ⭐ 앞의 규칙을 지우지 않고 **뒤에서 덮는다.** 카드·창(덮개)처럼 잘 도는 것은
      그대로 두고, 바뀐 자리(위쪽 바 · 검색 칸 · 결과 머리)만 다시 그린다.
      되돌릴 일이 생기면 이 블록만 지우면 된다.
   🛑 왼쪽 기둥(.옆)은 markup 에서 통째로 빠졌다 — 옛 .옆 규칙은 남아 있어도
      가리킬 것이 없어 아무 일도 하지 않는다 (정적shim.js 가 끼우는 규칙도 마찬가지).
   ══════════════════════════════════════════════════════════════════════ */
:root{
  --배경:#f3f6f7; --카드:#fff; --테두리:#e7edef; --진테두리:#d9e3e6;
  --글자:#0c1c26; --보조:#4f636c; --연보조:#84969c;
  --브랜드:#0d697c; --브랜드밝:#12a2b0; --브랜드연:#eaf5f7;
  --잉크:#0b2231; --잉크2:#123c52;
  --그늘:0 1px 2px rgba(10,30,42,.05), 0 10px 28px rgba(10,30,42,.07);
}
body{font-size:15.5px; letter-spacing:-.2px}

/* ── 위쪽 바 */
.머리{box-shadow:0 1px 0 rgba(12,31,44,.03)}
.머리안{max-width:1180px; margin:0 auto; padding:11px 20px; gap:20px}
.로고{font-size:21px}
.탭줄{gap:2px}
.탭{font-size:15px; padding:9px 15px; border-radius:10px}
.탭.켬{background:var(--브랜드연); color:var(--브랜드); border-color:transparent}

/* ── 판: 위(검색) / 아래(결과) */
.판{display:block; min-height:0}
.본{max-width:1180px; margin:0 auto; width:100%; padding:20px 20px 64px}

/* ── 히어로 = 검색 칸 하나만 있는 자리 */
.히어로{background:linear-gradient(135deg,var(--잉크) 0%, var(--잉크2) 100%);
        padding:18px 16px 24px}
.히어로안{max-width:1080px; margin:0 auto}

.여정줄{display:flex; gap:8px; margin-bottom:13px}
.여정{background:rgba(255,255,255,.10); border:1px solid rgba(255,255,255,.16);
      color:#cfe0e8; padding:8px 20px; border-radius:999px; font-size:14.5px; font-weight:700}
.여정.켬{background:#fff; border-color:#fff; color:var(--잉크)}

.칸들{display:grid; gap:8px; grid-template-columns:1fr}
@media (min-width:900px){
  .칸들{grid-template-columns:1.1fr 1.1fr .95fr .95fr}
  /* 항공은 칸이 셋이다 (출발지 · 목적지 · 날짜) — 넷짜리 자를 쓰면 빈 칸이 생긴다 */
  #항공폼 .칸들{grid-template-columns:1.1fr 1.1fr 1.2fr}
}
.칸{display:flex; align-items:center; gap:11px; width:100%; min-width:0;
    background:#fff; border:1px solid transparent; border-radius:12px; height:60px;
    padding:0 15px; text-align:left; font-size:16.5px; font-weight:700; color:var(--글자)}
.칸:hover{border-color:var(--브랜드밝)}
.칸 b{font-weight:700; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap}
.칸아이{color:#a3b4bb; font-size:16px; flex-shrink:0}
.칸 select{border:none; background:none; padding:0; width:100%; font-size:16.5px;
           font-weight:700; color:var(--글자); -webkit-appearance:none; appearance:none}
.칸 select:focus{outline:none}

.폼줄{display:flex; align-items:center; gap:18px; flex-wrap:wrap; margin-top:14px}
.사람칸{background:none; border:none; color:#fff; font-size:15px; font-weight:700; padding:2px 0}
.사람칸:hover{text-decoration:underline}
.스위치{display:flex; align-items:center; gap:9px; color:#dce8ec;
        font-size:14.5px; font-weight:600; cursor:pointer; user-select:none}
.스위치 input{display:none}
.스위치 i{width:42px; height:24px; border-radius:999px; background:rgba(255,255,255,.22);
          position:relative; transition:.18s; flex-shrink:0}
.스위치 i::after{content:''; position:absolute; top:3px; left:3px; width:18px; height:18px;
                 border-radius:50%; background:#fff; transition:.18s}
.스위치 input:checked + i{background:var(--브랜드밝)}
.스위치 input:checked + i::after{left:21px}
.더단추{background:none; border:none; color:#9dc2d0; font-size:14px; font-weight:700;
        margin-left:auto; padding:2px 0}
.더단추:hover{color:#fff}

.세부{margin-top:13px; background:rgba(255,255,255,.06); border-radius:12px;
      padding:13px 16px; color:#dce8ec}
.세부 .체크{color:#dce8ec}
.세부 .쪽제목{color:#9dc2d0; margin:12px 0 6px}
.세부 .쪽제목:first-child{margin-top:0}
.세부 select{background:rgba(255,255,255,.08); border-color:rgba(255,255,255,.22); color:#fff}
.세부 select option{color:var(--글자)}
.세부 .칩{background:rgba(255,255,255,.08); border-color:rgba(255,255,255,.22); color:#dce8ec}
.세부 .칩.켬{background:#fff; border-color:#fff; color:var(--잉크)}
.세부 .세로칩{color:#dce8ec}
.세부 .세로칩:hover{background:rgba(255,255,255,.08)}
.세부 .세로칩.켬{background:rgba(255,255,255,.14); color:#fff; box-shadow:inset 3px 0 0 var(--브랜드밝)}
.세부 hr{border:none; border-top:1px solid rgba(255,255,255,.14); margin:14px 0}

.히어로 .큰버튼{display:block; margin:14px 0 0 auto; border-radius:12px;
                background:var(--브랜드밝); padding:15px; font-size:17px}
.히어로 .큰버튼:hover{background:#0f8d99}
.히어로 .큰버튼:disabled{background:rgba(255,255,255,.25); color:rgba(255,255,255,.7)}
@media (min-width:900px){ .히어로 .큰버튼{width:auto; min-width:240px} }

/* ── 결과 */
.상태줄{padding:0 2px 12px; font-size:13px}
.도구{border-radius:14px; box-shadow:var(--그늘); border-color:var(--테두리); padding:12px 14px}
.결과글{font-size:17px}
.카드{border-radius:16px; box-shadow:var(--그늘); border-color:var(--테두리)}
/* '찾은 곳'은 이제 결과 머리에 눕는다 — 접었다 폈다 할 자리가 아니다 */
.지역머리{display:none}
.지역감{max-height:none !important; opacity:1 !important; overflow:visible}
#지역줄,#숙지역줄{display:none; width:100%}
#지역줄 hr,#숙지역줄 hr{display:none}
#지역칩,#숙지역칩{display:flex; flex-wrap:wrap; gap:6px}
.도구 .세로칩{width:auto; border:1px solid var(--진테두리); background:#fff;
              border-radius:999px; padding:7px 12px; font-size:13px; font-weight:600}
.도구 .세로칩.켬{background:var(--브랜드연); border-color:var(--브랜드밝);
                 color:var(--브랜드); box-shadow:none}
.도구 .세로칩 i{margin-left:4px}

/* ── 날짜 창 밑줄의 작은 단추 — [적용] 옆에서 눈에 안 띄게 작다 */
.작은연버튼{padding:6px 10px; font-size:12.5px; flex:none}

/* ══════════════════════════ ⭐ BEST — 배너 열 장
   🛑 카드가 아니라 **배너**다. 배너는 통째로 하나의 링크라, 안에 또 단추를 두지 않는다
      (안에 단추를 두면 어디를 눌러야 하는지가 손님의 숙제가 된다). */
.베머리글{display:flex; align-items:baseline; gap:10px; flex-wrap:wrap;
          padding:0 2px 12px; color:var(--연보조); font-size:12.5px}
.베머리글 b{color:var(--글자); font-size:17px; font-weight:800}
.베배너{display:flex; align-items:center; gap:13px; text-decoration:none; position:relative;
        background:var(--카드); border:1px solid var(--테두리); border-radius:16px;
        box-shadow:var(--그늘); padding:13px 15px 13px 18px; margin-bottom:9px; overflow:hidden;
        transition:transform .14s, box-shadow .14s, border-color .14s}
.베배너::before{content:''; position:absolute; left:0; top:0; bottom:0; width:5px;
                background:var(--띠, var(--브랜드밝))}
.베배너:hover{transform:translateY(-2px); border-color:var(--브랜드밝);
              box-shadow:0 9px 24px rgba(13,105,124,.14)}
.베번{width:20px; flex:none; text-align:center; font-size:12px; font-weight:800; color:#c3ced1}
.베배너.으뜸 .베번{color:var(--띠, var(--브랜드))}
.베깃{font-size:26px; line-height:1; flex:none}
.베속{flex:1; min-width:0}
.베도시{font-size:18px; font-weight:800; letter-spacing:-.5px}
.베나라{font-size:12px; color:var(--연보조); margin-left:6px}
.베날{display:block; font-size:12.5px; color:var(--보조); margin-top:3px;
      white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
.베돈{flex:none; text-align:right; white-space:nowrap}
.베돈 b{display:block; font-size:19px; font-weight:800; color:var(--브랜드); letter-spacing:-.5px}
.베돈 s{font-size:11.5px; color:var(--연보조)}
.베내림{display:inline-block; background:#fdecea; color:#c0392b; font-size:11px; font-weight:800;
        padding:2px 7px; border-radius:999px; margin-bottom:3px}
.베화{flex:none; font-size:21px; color:#ccd6d9}
.베주{padding:0 2px; margin-top:2px; color:var(--연보조); font-size:12px}
@media (max-width:560px){
  .베배너{gap:10px; padding:12px 12px 12px 15px}
  .베번{display:none}
  .베깃{font-size:22px}
  .베도시{font-size:16px}
  .베돈 b{font-size:17px}
  .베화{display:none}
}

/* ══════════════════════════ 🧳 내 여행 계획 — 첫 화면 아래
   ⭐ 여기 있는 이유: 조건을 안 고른 손님에게 [검색해 주세요] 만 보여 주면 화면이 죽는다.
      "언제 어디" 를 적어 두면 값이 내려갈 때 우리가 먼저 알려 준다 — 그게 다음 걸음이다.
   🛑 설명을 늘어놓지 않는다. 머리 한 줄과 칸 세 개면 끝이다. */
.계획칸{margin-top:14px}
.계획머리{display:flex; align-items:baseline; gap:9px; flex-wrap:wrap; padding:0 2px 10px}
.계획머리 b{font-size:16px; font-weight:800; letter-spacing:-.4px}
.계획머리 span{font-size:12.5px; color:var(--연보조)}
.계획들{display:grid; gap:10px; grid-template-columns:repeat(auto-fill, minmax(228px, 1fr))}
.계획{position:relative; background:var(--카드); border:1px solid var(--테두리);
      border-radius:16px; box-shadow:var(--그늘); padding:14px 15px 12px}
.계획 .속{display:block; width:100%; text-align:left; border:none; background:none; padding:0}
.계획 .곳{display:block; font-size:16px; font-weight:800; letter-spacing:-.4px; padding-right:18px}
.계획 .곳 em{font-style:normal; font-size:12px; font-weight:600; color:var(--연보조); margin-left:5px}
.계획 .때{display:block; font-size:12.5px; color:var(--보조); margin-top:3px}
.계획 .뺌{position:absolute; top:9px; right:10px; border:none; background:none;
          color:#c8d3d6; font-size:14px; line-height:1; padding:3px}
.계획 .뺌:hover{color:var(--빨강)}
/* ── 🔔 종 단추 — **이 칸의 목적이 이 단추 하나다.** 그래서 크고 색이 찬다.
   🛑 이모지 종(🔔)으로 하면 기기마다 다르게 생기고 색을 못 입힌다. 화면의 다른
      아이콘처럼 SVG 로 그린다 (달력·검색과 같은 집안이다).
   ⭐ 계획 칸과 계획 창이 **같은 단추**를 쓴다 — 손님이 두 번 배우지 않게. */
.종단추{display:inline-flex; align-items:center; gap:8px; height:44px;
        padding:0 16px 0 13px; border-radius:999px; border:1.5px solid var(--진테두리);
        background:#fff; font-size:13.5px; font-weight:800; color:var(--연보조);
        transition:background .16s, border-color .16s, color .16s, box-shadow .16s}
.종단추 svg{width:20px; height:20px; flex:none}
.종단추:hover{border-color:var(--브랜드밝); color:var(--브랜드)}
.종단추.켬{border-color:var(--브랜드); background:var(--브랜드); color:#fff;
           box-shadow:0 3px 10px rgba(13,105,124,.28)}
.종단추.켬:hover{background:var(--브랜드밝); border-color:var(--브랜드밝); color:#fff}
.계획 .종단추{margin-top:12px}
/* 켜는 순간 한 번 딸랑 — 눌렸다는 걸 손이 아니라 **눈으로** 알게 한다 */
.종단추.딸랑 svg{animation:딸랑 .55s ease}
@keyframes 딸랑{
  0%,100%{transform:rotate(0)}
  15%{transform:rotate(-16deg)}  30%{transform:rotate(13deg)}
  45%{transform:rotate(-9deg)}   60%{transform:rotate(6deg)}   75%{transform:rotate(-3deg)}
}
@media (prefers-reduced-motion:reduce){ .종단추.딸랑 svg{animation:none} }
/* ── 🗓 「날짜 지정 안 함」 — 계획 창의 [언제] 밑에 붙는 켬/끔 단추.
   ⭐ 날짜를 아직 못 정한 손님을 문 앞에서 돌려세우면 계획을 아예 안 적는다.
      "어디로" 만 정해 둬도 여섯 달 안에 값이 내려가면 알려 줄 수 있다.
   🛑 나라·도시와 같은 `.칩` 으로 두면 **고르는 자리가 셋으로** 보인다.
      네모 체크 하나로 "이건 켜고 끄는 것" 을 그림으로 말한다. */
.날없음{display:flex; align-items:center; gap:11px; width:100%; margin-top:8px;
        padding:11px 13px; border:1.5px solid var(--진테두리); border-radius:14px;
        background:#fff; text-align:left; cursor:pointer;
        transition:background .16s, border-color .16s, color .16s}
.날없음:hover{border-color:var(--브랜드밝); background:var(--브랜드연)}
.날없음 .네모{flex:none; width:22px; height:22px; border-radius:7px;
        border:1.5px solid var(--진테두리); background:#fff; color:transparent;
        display:flex; align-items:center; justify-content:center;
        transition:background .16s, border-color .16s, color .16s}
.날없음 .네모 svg{width:14px; height:14px}
.날없음 .글{font-size:14px; font-weight:700; color:var(--보조); line-height:1.35}
.날없음 .글 em{display:block; font-style:normal; font-size:12px; font-weight:600;
        color:var(--연보조); margin-top:3px}
.날없음.켬{border-color:var(--브랜드); background:var(--브랜드연)}
.날없음.켬 .네모{background:var(--브랜드); border-color:var(--브랜드); color:#fff}
.날없음.켬 .글{color:var(--브랜드)}
/* 켠 동안 달력 칸은 흐려진다 — 눌러도 안 열린다는 걸 눈으로 먼저 알려 준다 */
.칸:disabled{opacity:.45; cursor:default}
.칸:disabled:hover{border-color:var(--진테두리)}
/* 🎯 이 계획이 얼마를 기다리는지 — 적어 놓고 안 보여 주면 손님은 잊는다 */
.계획 .목표{display:block; font-size:12px; font-weight:700; color:var(--브랜드); margin-top:4px}
