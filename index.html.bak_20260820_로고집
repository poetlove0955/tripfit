function 숙넘어옴그리기() {
  const e = $('#숙넘어옴');
  if (!숙넘어옴) { e.innerHTML = ''; return; }
  const ㄴ = 숙넘어옴;
  e.innerHTML = `<div class="넘어옴">
    <span>✈ <b>${홑(ㄴ.목적지)}</b> 항공권 ${돈(ㄴ.값)}원에 맞춘 숙소입니다 —
      ${날짜보기(ㄴ.가는날)}${ㄴ.오는날 ? ' → ' + 날짜보기(ㄴ.오는날) : ' 부터 2박'}</span>
    <button class="연버튼 되돌기" onclick="숙넘어옴끄기()">✕ 조건 해제</button>
  </div>`;
}
function 숙넘어옴끄기() {
  숙넘어옴 = null; 숙넘어옴그리기(); 숙요약갱신();
}

function 숙결과받음(결과, 앞말) {
  숙바쁨(false); 숙작업 = null;
  숙비행보이기(false);
  숙줄들 = 결과.줄 || [];
  const 싼 = 결과.제일싼;
  const ㅎ = 결과.흐름요약 || null;
  let 날말 = '';
  if (ㅎ && ㅎ.이날) {
    const 할 = ㅎ.이날.할인 || 0;
    날말 = ` · 이 날짜는 이 도시 평균보다 ${할 > 0 ? `${할}% 낮음` : `${Math.abs(할)}% 높음`}`
         + ` (향후 ${ㅎ.본날수}일 중 하위 ${ㅎ.이날.자리}% 가격)`;
  }
  const 소 = 결과.소스별 || {};
  const 소글 = Object.keys(소).filter(k => k !== '값을 견준 곳' && 소[k])
                 .map(k => `${k} ${소[k]}`).join(' · ');
  /* 🛑 (2026-08-19) 항공과 같은 규칙 — 어떻게 찾았나·몇 초·특가 몇 건·찾아본 곳은 다 뺐다.
     남는 건 조건이 바뀌었다는 알림 하나뿐이다. (숙 · 소글 · 날말은 이제 안 쓴다) */
  const 숙알림 = String(앞말 || '').split('📦')[0].trim().replace(/·$/, '').trim();
  $('#숙상태').innerHTML = 숙알림 ? `<b>${홑(숙알림)}</b>` : '';
  숙지역칩만들기(); 숙종류칩만들기(); 숙정렬칩만들기();
  $('#숙도구줄').style.display = 'flex';
  숙그리기();
}

/* ── 도구줄 */
/* 🛑 [Trip Fit 추천] 은 **절대 못 누르게 만들면 안 된다.** 예전엔 추천이 0건이면
   disabled 를 걸었는데, 손님 눈에는 '있는데 안 눌리는 버튼' 이고 왜 안 되는지 알 길이 없다.
   추천은 **줄 세우는 자**다 — 추천할 만한 게 없으면 목록이 비는 게 아니라
   순위 밖 숙소들이 아래로 내려갈 뿐이다. 그러니 늘 눌린다. */
/* 결과 머리가 같이 읽는 목록 — 칩 이름과 머리 글자가 어긋나면 안 된다 */
const 숙정렬항목 = [['TripFit 추천', '추천'], ['가성비순', '가성비'], ['최저가순', '값'],
                    ['특가순', '특가'], ['후기순', '후기'], ['역세권순', '위치']];
const 숙정렬글 = v => (숙정렬항목.find(x => x[1] === v) || 숙정렬항목[0])[0];

/* ── 조건 접이 (숙소) */
let 숙조건폄 = false;
function 숙조건칩접기(켤까) {
  숙조건폄 = (켤까 === undefined) ? !숙조건폄 : !!켤까;
  $('#숙조건속').classList.toggle('폄', 숙조건폄);
  $('#숙조건단추').classList.toggle('켬', 숙조건폄);
}
function 숙조건단추갱신() {
  const 건 = [숙곳값 === '*' ? '' : 숙곳값,
              숙종류값 === '*' ? '' : 숙종류값,
              숙제외.size ? `${숙제외.size}종류 제외` : ''].filter(Boolean);
  $('#숙조건단추').innerHTML = 홑(조건줄임(건)) + ' <i>▾</i>';
