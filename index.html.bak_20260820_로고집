  const 아이 = 숙객.아이나이.length;
  return `성인 ${숙객.성인}명` + (아이 ? ` · 아이 ${아이}명` : '');
}
function 숙요약갱신() {
  $('#숙목적지버튼').querySelector('b').textContent = 숙목적지글();
  const 정 = 숙정한날();
  $('#숙언제칸글').textContent = 정 ? 긴날(정[0]) : 기간글(숙언제값);
  $('#숙며칠칸글').textContent = 정 ? 긴날(정[1]) : `${숙박값}박`;
  $('#숙사람칸글').textContent = 숙사람글();
}

function 숙조건모으기() {
  const 예 = $('#숙예산').value.replace('만원 이하', '').trim();
  return {
    성인: 숙객.성인, 아이나이: [...숙객.아이나이],
