          const 글 = 살곳글자[키] || k.slice(0, 1);
          const 값 = 여럿 ? undefined : 값찾기(k);
          const 왜 = 여럿 ? undefined : 막힌왜(k);
          // 🛑 [이 값] 은 **위에 뜬 값을 파는 곳**에만 붙인다.
          //    물어보고 나면 그 값은 네이버 게 아니라 제일 싼 곳 값이다 (8/9 오표기 사고).
          const 달력뿐 = !값 && !여럿 && k === '네이버' && 달력값 > 0;
          let 딱 = '', 덧 = '', 이름 = 홑(k);
          if (값) {
            딱 = `<b>${돈(값)}</b>`;
            이름 += ` — ${돈(값)}원 (물어봤습니다)`;
          } else if (왜) {
            딱 = `<b class="막힘딱">⚠</b>`; 덧 = ' 막힘';
            이름 += ` — 값을 뺐습니다: ${홑(왜)}`;
          } else if (달력뿐) {
            딱 = `<b class="달력값">${돈(달력값)}</b>`; 덧 = ' 달력';
            이름 += 물어봤나 ? ` — 네이버 달력값 ${돈(달력값)}원 (실제로 파는지는 안 물어봤습니다)`
                             : ` — 이 값 (네이버 달력값)`;
          } else {
            이름 += ' — 안 물어봤습니다';
          }
          return `<a href="${홑(v)}" target="_blank" rel="noopener" title="${이름}"
                     class="${딱 ? '' : '민'}${덧}${값 && 값 === 교.싼값 ? ' 싼곳' : ''}"
                     style="--점:${색}"><i>${홑(글)}</i>${딱}</a>`;
        }).join('') + `</div>`;
  }).join('');
  const 막힌수 = Object.keys(막힌곳).length;
  const 파는곳말 = 교 && (물어봤나 || 막힌수)
    ? `<em>어디서 사나요</em> · ${홑(교.한줄 || '')}<br>
