/* ── 항공 카드의 [🏨 숙소] 에서 넘어오는 문 */
async function 숙소찾기(i) {
  const r = 보임[i];
  if (!r) return;
  탭보이기('숙박');
  await 숙박깨우기();                 // 메타가 와야 칩·도시 목록을 그릴 수 있다
  숙넘어옴 = {목적지: r.목적지, 코드: r.코드,
             가는날: r.가는날, 오는날: r.오는날 || null,
             값: 보일값(r)};
  // 왼쪽 조건도 이 여행에 맞춰 둔다 — 손님이 [다시 찾기]를 눌러도 같은 여행이 나오게
  숙고른곳 = new Set([r.목적지]);
  if (r.오는날) {
    숙언제값 = '직접';
    숙시작 = 붙인날(r.가는날); 숙끝 = 붙인날(r.오는날);
    숙박값 = Math.max(1, 날수(숙시작, 숙끝));
  }
  숙요약갱신();
  숙박찾기();
}
function 붙인날(yyyymmdd) {
  const s = String(yyyymmdd);
  return `${s.slice(0,4)}-${s.slice(4,6)}-${s.slice(6,8)}`;
}

async function 숙박찾기() {
  if (숙도는중) return;
  await 숙박깨우기();
  숙바쁨(true);
  숙보이는수 = 30; 숙종류값 = '*';
  숙비행보이기(true);
  숙넘어옴그리기();
  $('#숙상태').textContent = '';

  const 몸 = 숙조건모으기();
  if (숙넘어옴) 몸.항공 = {목적지: 숙넘어옴.목적지, 코드: 숙넘어옴.코드,
                          가는날: 숙넘어옴.가는날, 오는날: 숙넘어옴.오는날};
  let 답;
  try {
    답 = await (await fetch(밑 + 'api/stay/search', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify(몸)
    })).json();
  } catch (e) { 숙실패('서버에 연결이 안 됩니다.'); return; }

  if (답.잘못) { 숙실패(답.잘못); return; }
  if (답.바로) { 숙결과받음(답.결과, 답.말); return; }
  숙작업 = 답.작업;
  if (답.앞에 > 0) $('#숙찾는말').textContent = `앞에 ${답.앞에}명이 찾고 있어요 — 곧 시작해요`;
  숙기다리기();
}

function 숙기다리기() {
  const 작업 = 숙작업;
  const 돌기 = async () => {
    if (숙작업 !== 작업) return;
    let 일;
    try { 일 = await (await fetch(밑 + 'api/job/' + 작업)).json(); }
    catch (e) { setTimeout(돌기, 1500); return; }
    if (일.잘못) { 숙실패(일.잘못); return; }
    숙안내갱신(일);
    if (일.상태 === '끝') { 숙결과받음(일.결과); return; }
    if (일.상태 === '실패') { 숙실패(일.말); return; }
    setTimeout(돌기, 900);
  };
  돌기();
}

function 숙안내갱신(일) {
  const 로그 = 일.로그 || [];
  let 말 = '숙소를 확인하고 있습니다';
  for (const l of 로그) {
    if (l.includes('차례를 기다')) 말 = '앞선 검색이 끝나는 대로 시작합니다';
    if (l.includes('아시아')) 말 = '도시별로 저렴한 날짜를 확인하고 있습니다';
    if (l.includes('갈라서')) 말 = '선택하신 도시를 날짜별로 확인하고 있습니다';
    if (l.includes('받았습니다')) 말 = '가격 대비 만족도를 매기고 있습니다';
    if (l.startsWith('[✈→🏨]')) 말 = '항공권 날짜에 맞춰 숙소를 찾고 있습니다';
  }
  $('#숙찾는말').textContent = 말;
  const [끝, 총] = 일.진행 || [0, 0];
  const m = $('#숙막대');
  if (총 && 끝 < 총) {
    m.classList.remove('흐름'); $('#숙막대속').style.width = Math.round(끝 / 총 * 100) + '%';
    $('#숙진행글').textContent = `${끝} / ${총}곳`;
  } else {
    m.classList.add('흐름'); $('#숙막대속').style.width = ''; $('#숙진행글').textContent = '';
  }
  $('#숙로그칸').textContent = 로그.join('\n');
  $('#숙로그칸').scrollTop = $('#숙로그칸').scrollHeight;
}

function 숙로그토글() {
  숙로그폄 = !숙로그폄;
  $('#숙로그칸').style.display = 숙로그폄 ? 'block' : 'none';
  $('#숙자세히단추').textContent = 숙로그폄 ? '접기' : '진행 자세히';
}
