/* ── 🎯 목표값 자(slider) — **적는 게 아니라 끄는 것.**
   손님은 "45만 3천원" 같은 걸 정하고 싶은 게 아니라 "이쯤" 을 정하고 싶다.
   그래서 5만원 칸으로 끊고, 지금 값은 위에 **크게** 보여 준다. */
.값고르기{border:1px solid var(--테두리); border-radius:14px; background:var(--줄무늬);
          padding:15px 15px 11px; margin-top:8px}
.값보임{display:flex; align-items:baseline; justify-content:center; gap:7px; margin-bottom:11px}
.값보임 b{font-size:27px; font-weight:800; letter-spacing:-1.2px; color:var(--브랜드);
          line-height:1}
.값보임 span{font-size:13px; font-weight:700; color:var(--보조)}
.값고르기.안정함 .값보임 b{font-size:19px; color:var(--보조)}
.값고르기.안정함 .값자{opacity:.42}
/* 🛑 크롬·파이어폭스가 서로 다른 이름을 쓴다. **둘 다** 적지 않으면 한쪽에서 자가
      민둥민둥한 줄로만 보인다. 찬 부분은 `--찬` 을 JS 가 %로 넣어 준다. */
.값자{-webkit-appearance:none; appearance:none; width:100%; height:28px;
      background:transparent; outline:none; margin:0; display:block; cursor:pointer}
.값자::-webkit-slider-runnable-track{height:8px; border-radius:999px;
      background:linear-gradient(to right, var(--브랜드) var(--찬,50%),
                                 var(--진테두리) var(--찬,50%))}
.값자::-webkit-slider-thumb{-webkit-appearance:none; appearance:none; width:28px; height:28px;
      margin-top:-10px; border-radius:50%; background:#fff; border:3px solid var(--브랜드);
      box-shadow:0 2px 9px rgba(13,105,124,.38); cursor:grab; transition:transform .12s}
.값자:active::-webkit-slider-thumb{cursor:grabbing; transform:scale(1.12)}
.값자::-moz-range-track{height:8px; border-radius:999px;
      background:linear-gradient(to right, var(--브랜드) var(--찬,50%),
                                 var(--진테두리) var(--찬,50%))}
.값자::-moz-range-thumb{width:22px; height:22px; border-radius:50%; background:#fff;
      border:3px solid var(--브랜드); box-shadow:0 2px 9px rgba(13,105,124,.38); cursor:grab}
.값자:focus-visible::-webkit-slider-thumb{outline:2px solid var(--브랜드밝); outline-offset:2px}
.값끝{display:flex; align-items:center; justify-content:space-between; gap:8px; margin-top:9px}
.값끝 span{font-size:11.5px; font-weight:700; color:var(--연보조)}
.값끝 .칩{padding:5px 11px; font-size:12px}
.계획더{display:flex; align-items:center; justify-content:center; gap:7px; min-height:98px;
        border:1.5px dashed var(--진테두리); border-radius:16px; background:none;
        color:var(--연보조); font-size:14px; font-weight:700}
.계획더:hover{border-color:var(--브랜드밝); color:var(--브랜드); background:var(--브랜드연)}
.계획말{padding:11px 2px 0; font-size:12px; color:var(--연보조)}
/* ── 폰에서는 계획 하나가 **한 줄**이다.
   🛑 PC 꼴(칸 세로 쌓기)을 그대로 두면 계획 셋이 600px 을 먹어, 손님은
      값을 보러 와서 자기 계획만 스크롤하게 된다. */
@media (max-width:560px){
