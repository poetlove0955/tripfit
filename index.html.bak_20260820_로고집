let 줄들 = [], 보임 = [], 담은 = [], 지금작업 = null, 끝난작업 = null, 도는중 = false;
/* 🛑 기본은 '싼 순'이다 — 싼 표를 찾으러 온 사람에게 특가율부터 들이밀지 않는다 */
let 지역값 = '*', 달값 = '*', 박값 = '*', 정렬값 = '값', 보이는수 = 30, 펼친 = null;
const 살곳색 = {네이버: '#03C75A', 구글: '#4285F4', 스카이스캐너: '#0770E3',
                카약: '#FF690F', 트립닷컴: '#2681FF', 키위: '#00A991',
                직판: '#E8590C'};
/* 단추에 한 자만 적는다. 직판은 "제주항공 직판" 처럼 항공사 이름이 앞에 붙어 오니
   뒤의 ' 직판' 을 보고 한 칸으로 모은다 (색·글자를 항공사마다 따로 두지 않는다). */
const 살곳글자 = {네이버: '네', 구글: '구', 스카이스캐너: '스',
                  카약: '카', 트립닷컴: '트', 키위: '키', 직판: '직'};
const 살곳키 = k => (k.endsWith(' 직판') ? '직판' : k);
let 지역항목 = [], 지역펼침 = true, 지역타이머 = null;
let 마지막글 = '';

const 탭들 = [['항공권', '항공권'], ['숙소', '숙박'], ['BEST', '베스트']];

/* ─────────────────────────────────────────── 시작 */
async function 시작() {
  탭그리기();
  /* 미리 찾아 둔 값으로 도는 공개 사이트에서는 대표용 도구(★·콘텐츠)를 감춘다 —
     눌러도 안 되는 단추는 손님 눈에 '고장'으로 보인다. (정적shim.js 가 표시를 남긴다) */
  if (window.TF미리찾음) document.body.classList.add('손님용');
  try {
    메타 = await (await fetch(밑 + 'api/meta')).json();
  } catch (e) { $('#상태').textContent = '자료를 불러오지 못했습니다.'; return; }

  $('#출발지').innerHTML = 메타.출발지.map(x => `<option>${홑(x)}</option>`).join('');
  여행객.좌석 = (메타.좌석 || []).includes(여행객.좌석) ? 여행객.좌석 : (메타.좌석 || ['일반석'])[0];
  $('#예산').innerHTML = ['상관없음','20만원 이하','30만원 이하','40만원 이하','50만원 이하',
                          '70만원 이하','100만원 이하'].map(x => `<option>${홑(x)}</option>`).join('');
  const 이레뒤 = 날더하기(메타.오늘, 7);
  $('#시작날').value = 이레뒤;
  $('#끝날').value  = 날더하기(이레뒤, 2);
  ['#출발지','#예산','#직항만','#주말만'].forEach(s =>
    $(s).addEventListener('change', 요약갱신));
  빈화면();
  요약갱신();
  계획시작();

  /* 들어올 때 #숙박 이었으면 지금탭 은 이미 '숙박' 이다(맨 밑 첫자리잡기 참고). */
  if (지금탭 !== '항공권') {
    자리되돌림 = true;                       // 첫 화면이니 자리를 새로 쌓지 않는다
    try { 탭보이기(지금탭); } finally { 자리되돌림 = false; }
  }
}

function 탭그리기() {
  $('#탭줄').innerHTML = 탭들.map(([g, v]) =>
    `<button class="탭${v === 지금탭 ? ' 켬' : ''}" data-v="${v}">${g}</button>`).join('');
  $('#탭줄').querySelectorAll('.탭').forEach(b => b.onclick = () => 탭보이기(b.dataset.v));
}

function 탭보이기(v) {
  const 전탭 = 지금탭;
  지금탭 = v; 탭그리기();
  // 탭이 바뀌면 히스토리에 자리를 하나 쌓는다 → 브라우저 ← 가 '전 탭'이 된다
  if (!자리되돌림 && v !== 전탭) 자리쌓기({곳: '탭', 탭: v});
  const 항공 = (v === '항공권'), 숙박 = (v === '숙박'), 베스트 = (v === '베스트');
  $('#항공권쪽').style.display = 항공 ? 'block' : 'none';
  $('#숙박쪽').style.display   = 숙박 ? 'block' : 'none';
  $('#베스트쪽').style.display = 베스트 ? 'block' : 'none';
  $('#항공폼').style.display   = 항공 ? 'block' : 'none';
  $('#숙박폼').style.display   = 숙박 ? 'block' : 'none';
  if (숙박) 숙박깨우기();
  if (베스트) 베스트깨우기();
  계획보이기();
}

/* ─────────────────────────────────────────── 조건 칸 */
function 칩그리기(자리, 항목, 지금, 골랐을때) {
  const 그리기 = () => {
    $(자리).innerHTML = 항목.map(([글, 값], i) =>
      `<button class="칩${JSON.stringify(값) === JSON.stringify(지금()) ? ' 켬' : ''}"
        data-i="${i}">${홑(글)}</button>`).join('');
    $(자리).querySelectorAll('.칩').forEach(b => b.onclick = () => {
      골랐을때(항목[+b.dataset.i][1]); 그리기();
    });
  };
  그리기();
}

function 조건접기(펼침) { /* 옛 왼쪽 기둥의 접기 — 검색 칸이 위로 올라와 할 일이 없다 */ }
function 자세히접기() {
  자세히펼침 = !자세히펼침;
  $('#자세히').style.display = 자세히펼침 ? 'block' : 'none';
  $('#자세히머리').textContent = '세부 조건 ' + (자세히펼침 ? '▴' : '▾');
}
function 숙자세히접기() {
  const 켬 = $('#숙자세히').style.display !== 'block';
  $('#숙자세히').style.display = 켬 ? 'block' : 'none';
  $('#숙자세히머리').textContent = '세부 조건 ' + (켬 ? '▴' : '▾');
}
function 여정바꾸기(편도) {
  $('#편도').checked = !!편도;
  $('#여정왕복').classList.toggle('켬', !편도);
  $('#여정편도').classList.toggle('켬', !!편도);
  $('#항공폼').classList.toggle('편도', !!편도);
  요약갱신();
}

/* ── '며칠 다녀와요?' 는 없앴다. 날짜를 고르면 거기서 박수가 나오고,
      기간(3개월 안 …)으로 찾을 땐 **며칠이든 다 본다**.
      🛑 여기를 [2,2] 로 뒀다가 "한 달 안"이 죄다 2박만 나오는 사고를 냈다.
         네이버는 tripDays 를 **리스트 하나로** 받는다 — 넓혀도 요청 수는 그대로다. */
const 기본박 = [1, 10];
function 날더하기(iso, n) {
  const [y, m, d] = iso.split('-').map(Number);
  const t = new Date(y, m - 1, d + n), p = x => String(x).padStart(2, '0');
  return `${t.getFullYear()}-${p(t.getMonth() + 1)}-${p(t.getDate())}`;
}
function 날수(a, b) {
  const [y1, m1, d1] = a.split('-').map(Number), [y2, m2, d2] = b.split('-').map(Number);
  return Math.round((new Date(y2, m2 - 1, d2) - new Date(y1, m1 - 1, d1)) / 86400000);
}
function 정한날() {                    // [가는날, 오는날, 박] — 안 정했으면 null
  if (언제값 !== '직접') return null;
  const 시 = $('#시작날').value, 끝 = $('#끝날').value;
  if (!시 || !끝) return null;
  const 박 = 날수(시, 끝);
  /* 🛑 편도는 0(가는 날만)도 정해진 것이다. 왕복까지 0 을 받아 주면
     편도로 고른 뒤 왕복으로 되돌렸을 때 '9/4 → 9/4' 같은 0일 여행이 남는다. */
  return (박 >= ($('#편도').checked ? 0 : 1) && 박 <= 30) ? [시, 끝, 박] : null;
}
/* 며칠 다녀오나. 🛑 여기 값은 공장이 미리 훑어 둔 **박 버킷과 1:1** 이어야 한다 —
   어긋나면 손님은 "찾았는데 아무것도 없다"만 보고 이유를 모른다. */
const 박칸값 = {'0': [0, 0], '1': [1, 1], '2': [2, 2], '3': [3, 3],
                '4-6': [4, 6], '6-8': [6, 8], '*': 기본박};
function 며칠값() {
  const 정 = 정한날();
  return 정 ? [정[2], 정[2]] : (박칸값[박칸] || 기본박);
}

/* ── 달력 하나로 가는 날·오는 날을 한 번에 (첫 번째 누름 = 가는 날, 두 번째 = 오는 날) */
let 임시시 = '', 임시끝 = '';
/* 창은 늘 달력('지정')으로 연다. '유연' 은 [날짜 지정 안 함] 으로만 들어간다. */
let 달모드값 = '지정', 임시기간 = '여섯달', 임시박 = '*';
/* 기간 고르기는 없앴다 — 안 정하면 늘 '여섯달'(우리가 훑어 둔 전부)이다.
   목록을 남겨 두는 건 예전에 골라 둔 값이 남아 있을 때 글자를 뽑기 위해서다. */
const 기간항목 = [['2주 이내', '2주'], ['1개월 이내', '한달'],
                  ['3개월 이내', '석달'], ['날짜 지정 안 함', '여섯달']];
const 숙박박항목 = [['1박', '1'], ['2박', '2'], ['3박', '3'], ['5박', '5'], ['7박', '7']];

function 기간글(값) { const 짝 = 기간항목.find(x => x[1] === 값); return 짝 ? 짝[0] : '날짜 지정 안 함'; }
function 긴날(iso) {
  const [y, m, d] = iso.split('-').map(Number);
  return `${m}월 ${d}일 (${'일월화수목금토'[new Date(y, m - 1, d).getDay()]})`;
}

/* 어디 === '박' 이면 [며칠 묵나] 칸을 누른 것이다 (숙소·BEST 에만 있다).
   그 외에는 **늘 달력부터** 연다 — 날짜를 지정하러 누른 것이니까. */
function 달력열기(갈래, 어디) {
  모달갈래 = 갈래 || '항공';
  /* 🛑 날짜를 안 정한 칸(여섯달)인데 달력에 날짜가 미리 칠해져 있으면,
     손님은 고르지도 않은 날이 이미 정해진 줄 안다 — 그때는 빈 달력으로 연다. */
  if (모달갈래 === '숙박') {
    const 직 = (숙언제값 === '직접');
    임시시 = 직 ? 숙시작 : ''; 임시끝 = 직 ? 숙끝 : '';
    임시기간 = '여섯달'; 임시박 = String(숙박값);
  } else if (모달갈래 === '계획') {
    /* 🧳 여행 계획 — 날짜는 **골라도 되고 안 골라도 된다**(계획 창의 [날짜 지정 안 함]).
       안 고르면 빈 칸으로 두고, 그 빈 칸이 곧 「앞으로 여섯 달 아무 때나」다. */
    임시시 = (계획중 && 계획중.시작) || ''; 임시끝 = (계획중 && 계획중.끝) || '';
    임시기간 = '여섯달'; 임시박 = '2';
  } else {
    임시시 = (언제값 === '직접') ? ($('#시작날').value || '') : '';
    임시끝 = (언제값 === '직접') ? ($('#끝날').value || '') : '';
    임시기간 = (언제값 === '직접') ? '여섯달' : 언제값; 임시박 = 박칸;
  }
  // 날짜가 이미 정해져 있으면 [며칠] 을 눌러도 달력을 연다 — 박수는 날짜에서 나오니까
  달모드값 = (어디 === '박' && 모달갈래 !== '항공' && !임시시) ? '유연' : '지정';
  달창그리기(); 열기('달덮개');
  // 골라 둔 달이 바로 보이게 (안 그러면 늘 첫 달부터 내려야 한다)
  const 속 = $('#달속');
  const 달 = 임시시 && 속.querySelector(`.달[data-ym="${임시시.slice(0, 7)}"]`);
  속.scrollTop = 달 ? Math.max(0, 달.offsetTop - 속.offsetTop - 6) : 0;
}

function 달모드(m) { 달모드값 = m; 달창그리기(); }

/* 밑줄의 작은 단추. 항공은 고를 게 없으니 **누르는 즉시 적용**하고 창을 닫는다.
   숙소는 날짜를 안 정해도 '며칠 묵나'는 있어야 해서 그 칸으로 넘어간다. */
function 달모드바꾸기() {
  if (달모드값 === '지정') {
    if (모달갈래 === '항공') {
      언제값 = '여섯달'; 박칸 = '*'; $('#시작날').value = ''; $('#끝날').value = '';
      닫기('달덮개'); 요약갱신(); return;
    }
    임시기간 = '여섯달'; 달모드('유연');
  } else 달모드('지정');
}

function 달창그리기() {
  const 숙 = (모달갈래 === '숙박');
  const 계 = (모달갈래 === '계획');
  $('#달제목').textContent = 숙 ? '숙박 일정' : (계 ? '여행 계획 날짜' : '여행 일정');
  /* 🛑 여기서는 그 문을 안 연다 — 계획의 [날짜 지정 안 함] 은 **계획 창에 한 자리**뿐이다.
     같은 뜻의 단추가 둘이면 켠 자리와 꺼진 자리가 어긋난다. */
  $('#달모드단추').style.display = 계 ? 'none' : '';
  const 지정 = (달모드값 === '지정');
  $('#유연칸').style.display = 지정 ? 'none' : '';
  $('#지정칸').style.display = 지정 ? '' : 'none';
  $('#달지움').style.display = (지정 && (임시시 || 임시끝)) ? '' : 'none';
  $('#달모드단추').textContent = 지정 ? '날짜 지정 안 함' : '날짜 지정하기';
  if (지정) 달력그리기(); else 유연그리기();
  달확인갱신();
}

function 유연그리기() {
  if (!숙박박항목.some(x => x[1] === 임시박)) 임시박 = '2';
  $('#박수칩').innerHTML = 숙박박항목.map(([g, v]) =>
    `<button class="칩${v === 임시박 ? ' 켬' : ''}" data-v="${v}">${g}</button>`).join('');
  $('#박수칩').querySelectorAll('.칩').forEach(b =>
    b.onclick = () => { 임시박 = b.dataset.v; 유연그리기(); });
}
function 달력그리기() {
  const 오늘 = 메타.오늘;
  const [y0, m0] = 오늘.split('-').map(Number);
  let h = '';
  for (let k = 0; k < 7; k++) {                       // 오늘 달부터 일곱 달
    const d = new Date(y0, m0 - 1 + k, 1);
    h += 달하나(d.getFullYear(), d.getMonth() + 1, 오늘);
  }
  $('#달속').innerHTML = h;
  $('#달속').querySelectorAll('.날들 button[data-d]').forEach(b =>
    b.onclick = () => 날눌림(b.dataset.d));
  달확인갱신();
}
function 달하나(y, m, 오늘) {
  const 첫 = new Date(y, m - 1, 1).getDay(), 끝일 = new Date(y, m, 0).getDate();
  let 칸 = '<span></span>'.repeat(첫);
  for (let d = 1; d <= 끝일; d++) {
    const iso = `${y}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
    const 지남 = iso < 오늘;
    const 시 = iso === 임시시, 끝 = iso === 임시끝;
    const 사이 = 임시시 && 임시끝 && iso > 임시시 && iso < 임시끝;
    const 결 = [시 && '시', 끝 && '끝', 사이 && '사이', 시 && !임시끝 && '홀']
                 .filter(Boolean).join(' ');
    칸 += `<button class="${결}" ${지남 ? 'disabled' : `data-d="${iso}"`}>${d}</button>`;
  }
  // 요일 줄은 달마다 안 그린다 — 상자 위에 붙박이로 하나만 있다
  return `<div class="달" data-ym="${y}-${String(m).padStart(2, '0')}">
    <div class="달이름">${y}년 ${m}월</div>
    <div class="날들">${칸}</div></div>`;
}
function 날눌림(iso) {
  if (!임시시 || 임시끝 || iso <= 임시시) { 임시시 = iso; 임시끝 = ''; }
  else 임시끝 = iso;
  const 속 = $('#달속'), 자리 = 속.scrollTop;   // 다시 그려도 보던 달에 그대로 머물게
  달창그리기();
  속.scrollTop = 자리;
}
function 달지우기() { 임시시 = ''; 임시끝 = ''; 달창그리기(); }

/* 창 아래 [적용] 과 위쪽 두 칸(가는 날·오는 날)의 상태를 한 자리에서 맞춘다.
   🛑 편도는 '오는 날' 없이도 적용된다 — 없는 칸을 기다리면 단추가 영영 안 켜진다. */
function 달확인갱신() {
  const 편도 = (모달갈래 === '항공') && $('#편도').checked;
  const 다 = !!(임시시 && (편도 || 임시끝));
  $('#달확인').disabled = (달모드값 === '지정') && !다;
  $('#달확인').textContent = (달모드값 === '유연') ? '적용'
    : (다 ? '적용' : (임시시 ? (편도 ? '적용' : '오는 날을 골라주세요') : '가는 날을 골라주세요'));
  if (달모드값 !== '지정') return;
  const 숙 = (모달갈래 === '숙박');
  $('#달칸시 span').textContent = 숙 ? '체크인' : '가는 날';
  $('#달칸끝 span').textContent = 숙 ? '체크아웃' : '오는 날';
  $('#달시').textContent = 임시시 ? 짧은날(임시시) : '눌러주세요';
  $('#달끝').textContent = 임시끝 ? 짧은날(임시끝) : (임시시 ? '눌러주세요' : '—');
  $('#달박').textContent = (임시시 && 임시끝)
    ? ((모달갈래 === '숙박') ? `${날수(임시시, 임시끝)}박` : `${날수(임시시, 임시끝)}일`) : '—';
  // 지금 고를 차례인 칸을 켜 둔다 — 어디를 눌러야 하는지 눈으로 알게
  $('#달칸시').className = '달칸' + (임시시 ? '' : ' 차례 빔');
  $('#달칸끝').className = '달칸' + (임시끝 ? '' : (임시시 ? ' 차례 빔' : ' 빔'));
}
function 달정하기() {
  const 편도 = (모달갈래 === '항공') && $('#편도').checked;
  if (달모드값 === '지정') {
    if (!임시시 || (!편도 && !임시끝)) return;
    const 끝 = 임시끝 || 임시시;
    if (모달갈래 === '숙박')      { 숙언제값 = '직접'; 숙시작 = 임시시; 숙끝 = 끝; }
    else if (모달갈래 === '계획') {
      // 날짜를 골랐다는 건 [날짜 지정 안 함] 을 그만두겠다는 뜻이다
      계획중.시작 = 임시시; 계획중.끝 = 끝; 계획중.날짜없음 = false;
    }
    else { 언제값 = '직접'; $('#시작날').value = 임시시; $('#끝날').value = 끝; }
  } else {
    /* 날짜를 안 정한 길. 기간은 늘 '여섯달'(우리가 훑어 둔 전부)이다. */
    if (모달갈래 === '숙박')      { 숙언제값 = '여섯달'; 숙박값 = +임시박; 숙시작 = ''; 숙끝 = ''; }
    else { 언제값 = '여섯달'; 박칸 = '*'; $('#시작날').value = ''; $('#끝날').value = ''; }
  }
  닫기('달덮개');
  if (모달갈래 === '숙박') 숙요약갱신();
  else if (모달갈래 === '계획') 계획창갱신();
  else 요약갱신();
}
function 짧은날(iso) {
  const [y, m, d] = iso.split('-').map(Number);
  return `${m}/${d}(${'일월화수목금토'[new Date(y, m - 1, d).getDay()]})`;
}

function 목적지글() {
  if (!고른곳.size) return '어디든지';
  const 목 = [...고른곳];
  return 목.length <= 2 ? 목.join(' · ') : `${목[0]} 외 ${목.length - 1}곳`;
}
/* 날짜 칸에 적을 한 줄. 세 갈래다 —
   ① 다 정함 ② 가는 날만 정하고 오는 날이 빈 채로 왕복이 됨 ③ 아예 안 정함 */
function 언제글() {
  const 정 = 정한날(), 편도 = $('#편도').checked;
  if (정) return 편도 ? 짧은날(정[0]) : `${짧은날(정[0])} → ${짧은날(정[1])}`;
  const 시 = (언제값 === '직접') ? $('#시작날').value : '';
  return 시 ? `${짧은날(시)} → 오는 날 고르기` : 기간글(언제값);
}
// 🛑 화면이 두 말을 쓰면 헷갈린다 — 항공은 **일**로 통일
function 며칠글() { const 정 = 정한날(); return 정 ? `${정[2]}일` : '왕복'; }
function 조건말() {
  const 편도 = $('#편도').checked;
  const 정 = 정한날();
  /* 혼자·일반석이면 굳이 안 쓴다 — 손댄 사람에게만 보인다 */
  const 기본객 = (여행객.성인 === 1 && !여행객.아이나이.length
                && 여행객.좌석 === ((메타.좌석 || ['일반석'])[0]));
  return `${$('#출발지').value} → ${목적지글()}\n`
       + `${언제글()} · ${편도 ? '편도' : 며칠글()}`
       + (기본객 ? '' : `\n${사람글()} · ${여행객.좌석}`);
}
function 요약갱신() {
  $('#목적지버튼').querySelector('b').textContent = 목적지글();
  /* 칸이 하나라 가는 날·오는 날을 한 줄에 같이 적는다 */
  $('#언제칸글').textContent = 언제글();
  사람단추갱신();
}

/* 목적지 고르기 — 항공·숙박이 **같은 창**을 쓴다.
   🛑 어느 탭이 열었는지(모달갈래)를 안 기억하면 숙박에서 고른 도시가
      항공 조건으로 들어간다. 열 때 적어 두고 [이걸로] 에서 그대로 읽는다. */
let 모달갈래 = '항공';
function 곳고르기열기(갈래) {
  모달갈래 = 갈래 || '항공';
  임시곳 = new Set(모달갈래 === '숙박' ? 숙고른곳 : 고른곳);
  곳목록그리기();
  열기('곳덮개');
}
/* 나라 묶음이 나오는 차례 — 실제로 많이 가는 순서다.
   🛑 자료(항공검색설정.json)에 적힌 차례를 그대로 쓰면 도시를 하나 더할 때마다
      화면 순서가 멋대로 바뀐다. 그래서 여기 한 줄이 순서의 진실이다. */
const 나라차례 = ['베트남', '태국·말레이·싱가포르', '일본',
                  '필리핀·인니·기타', '중국·대만·홍콩', '괌', '사이판'];
const 나라번호 = g => { const i = 나라차례.indexOf(g); return i < 0 ? 99 : i; };

function 곳목록그리기() {
  const 지역별 = {};
  (모달갈래 === '숙박' ? (숙메타.도시 || []) : 메타.목적지)
    .forEach(c => (지역별[c.지역] = 지역별[c.지역] || []).push(c));
  const 묶음 = Object.entries(지역별)
    .sort((a, b) => 나라번호(a[0]) - 나라번호(b[0]) || a[0].localeCompare(b[0], 'ko'));
  const 속 = $('#곳덮개 .상자속');
  const 스크롤 = 속 ? 속.scrollTop : 0;               // 나라 단추를 눌러도 자리를 안 잃게

  $('#곳목록').innerHTML = 묶음.map(([g, 곳들], gi) => {
    const 켠수 = 곳들.filter(c => 임시곳.has(c.이름)).length;
    const 다 = 켠수 === 곳들.length;
    return `<div class="곳머리">
        <b>${홑(g)}</b>
        <span class="곳수">${켠수 ? `${켠수} / ${곳들.length}곳` : `${곳들.length}곳`}</span>
        <button class="지역단추${다 ? ' 켬' : ''}" data-g="${gi}">${다 ? '✔ 전부 빼기' : '＋ 전부'}</button>
      </div>
      <div class="곳고르기">${곳들.map(c =>
        `<button class="곳${임시곳.has(c.이름) ? ' 켬' : ''}" data-n="${홑(c.이름)}">
           <span>${임시곳.has(c.이름) ? '✔' : '＋'}</span>${홑(c.이름)}</button>`).join('')}</div>`;
  }).join('');

  $('#곳목록').querySelectorAll('.곳').forEach(b => b.onclick = () => {
    const n = b.dataset.n;
    if (임시곳.has(n)) 임시곳.delete(n); else 임시곳.add(n);
    곳목록그리기();                       // 나라 머리의 '3 / 12곳' 도 같이 따라가야 한다
  });
  // 나라 하나를 통째로 — 하나씩 열두 번 누르게 두지 않는다
  $('#곳목록').querySelectorAll('.지역단추').forEach(b => b.onclick = () => {
    const 곳들 = 묶음[+b.dataset.g][1];
    const 다 = 곳들.every(c => 임시곳.has(c.이름));
    곳들.forEach(c => 다 ? 임시곳.delete(c.이름) : 임시곳.add(c.이름));
    곳목록그리기();
  });
  if (속) 속.scrollTop = 스크롤;
  곳센다();
}
function 곳센다() {
  const n = 임시곳.size, 최대 = 메타.최대목적지 || 25;
  const e = $('#곳센다');
  const 넘침 = n > 최대;
  e.textContent = 넘침 ? `${n}곳 — 한 번에 ${최대}곳까지만 됩니다`
    : (n ? `${n}곳 선택` : '선택하지 않으면 전체에서 찾습니다');
  e.style.color = 넘침 ? 'var(--빨강)' : '';
  e.style.fontWeight = 넘침 ? '700' : '';
  const 확 = $('#곳덮개 .큰버튼');
  if (확) 확.disabled = 넘침;
}
function 곳전부끄기() { 임시곳.clear(); 곳목록그리기(); }
function 곳정하기() {
  if (모달갈래 === '숙박') { 숙고른곳 = new Set(임시곳); 닫기('곳덮개'); 숙요약갱신(); return; }
  고른곳 = new Set(임시곳); 닫기('곳덮개'); 요약갱신();
}

/* ─────────────────────────────────────────── 여행객 (몇 명 · 몇 살 · 어떤 자리)
   나이를 왜 받나: 만 2세 미만은 **유아**(무릎 위)라 값이 아예 다르고,
   2~11세는 소아 요금이 따로 있다. 예약 화면에 그대로 넘겨야 헛값을 안 본다. */
const 유아나이 = 2;                                   // 만 2세 미만 = 유아
const 유아수 = 객 => 객.아이나이.filter(n => n < 유아나이).length;
const 소아수 = 객 => 객.아이나이.filter(n => n >= 유아나이).length;

function 사람글() {
  const 아이 = 여행객.아이나이.length;
  return `성인 ${여행객.성인}명` + (아이 ? ` · 유/소아 ${아이}명` : '');
}
function 사람단추갱신() {
  const b = $('#사람단추');
  if (b) b.textContent = `여행객 ${여행객.성인 + 여행객.아이나이.length}명`;
}

function 사람고르기열기(갈래) {
  모달갈래 = 갈래 || '항공';
  const 원 = (모달갈래 === '숙박') ? 숙객 : 여행객;
  임시객 = {성인: 원.성인, 아이나이: [...원.아이나이], 좌석: 여행객.좌석};
  사람그리기();
  열기('사람덮개');
}

function 사람세기(누구, 몇) {
  const 합 = 임시객.성인 + 임시객.아이나이.length;
  if (몇 > 0 && 합 >= 최대여행객) return;
  if (누구 === '성인') 임시객.성인 = Math.max(1, Math.min(최대여행객, 임시객.성인 + 몇));
  else if (몇 > 0) 임시객.아이나이.push(기본아이나이);
  else 임시객.아이나이.pop();
  사람그리기();
}
function 나이바꿈(i, v) { 임시객.아이나이[i] = parseInt(v); 사람그리기(); }

function 사람그리기() {
  const 아이 = 임시객.아이나이.length, 합 = 임시객.성인 + 아이;
  const 꽉 = 합 >= 최대여행객;
  const 숙 = (모달갈래 === '숙박');       // 숙소는 '방에 몇 명' 이다

  $('#사람덮개 .상자머리 b').textContent = 숙 ? '인원' : '여행객';

  $('#좌석칩').innerHTML = (메타.좌석 || ['일반석']).map(x =>
    `<button class="칩${x === 임시객.좌석 ? ' 켬' : ''}" data-v="${홑(x)}">${홑(x)}</button>`).join('');
  $('#좌석칩').querySelectorAll('.칩').forEach(b =>
    b.onclick = () => { 임시객.좌석 = b.dataset.v; 사람그리기(); });

  $('#어른수').textContent = 임시객.성인;
  $('#아이수').textContent = 아이;
  $('#어른뺌').disabled = 임시객.성인 <= 1;
  $('#아이뺌').disabled = 아이 <= 0;
  $('#어른더').disabled = $('#아이더').disabled = 꽉;

  const 칸 = $('#나이칸');
  칸.style.display = 아이 ? 'block' : 'none';
  if (아이) {
    칸.innerHTML = 임시객.아이나이.map((나, i) => `
      <div class="나이줄"><span>${i + 1}번째 아이 나이</span>
        <select data-i="${i}">${[...Array(18).keys()].map(n =>
          `<option value="${n}"${n === 나 ? ' selected' : ''}>${
            n < 유아나이 ? `${n}세 (유아)` : `${n}세`}</option>`).join('')}</select></div>`).join('');
    칸.querySelectorAll('select').forEach(s =>
      s.onchange = () => 나이바꿈(+s.dataset.i, s.value));
  }

  if (숙) {
    // 숙박은 **방 하나에 몇 명**이냐다. 유아 무릎 규칙도, 어른 1명 값도 여기선 없다.
    $('#사람말').innerHTML = '방 <b>1개</b> 기준입니다. 아이 나이는 아고다가 '
      + '<b>무료 투숙 나이</b>를 따지는 데 씁니다.'
      + (꽉 ? `<br>한 방에 ${최대여행객}명까지 찾을 수 있습니다.` : '');
    const 확숙 = $('#사람덮개 .큰버튼');
    if (확숙) 확숙.disabled = false;
    return;
  }

  /* 🛑 값이 어떻게 매겨지는지는 숨기지 않는다 — 카드값은 늘 어른 1명 값이다 */
  const 유 = 유아수(임시객), 소 = 소아수(임시객), 넘침 = 유 > 임시객.성인;
  /* 🛑 실측(2026-08-09)한 곳만 적는다 — 스카이스캐너·카약은 봇 확인에 막혀 확인 못 했다 */
  let 말 = '카드에 보이는 값은 <b>성인 1명 기준</b>입니다. '
         + '인원·나이는 <b>네이버·트립닷컴</b>으로 예약하러 갈 때 그대로 실려 갑니다 '
         + '(다른 곳은 그 화면에서 인원을 다시 골라주세요).';
  if (유) 말 += `<br>만 ${유아나이}세 미만 ${유}명은 <b>유아(무릎 위)</b> 요금으로 잡힙니다.`;
  if (소) 말 += `<br>${유아나이}~17세 ${소}명은 소아 요금이라 성인과 값이 다릅니다.`;
  if (꽉) 말 += `<br>한 번에 ${최대여행객}명까지 찾을 수 있습니다.`;
  /* 무릎 위 유아는 어른 한 명당 한 명까지다 — 넘으면 예약 화면이 거절한다 */
  if (넘침) 말 += `<br><b style="color:var(--빨강)">만 ${유아나이}세 미만은 성인 수(${
    임시객.성인}명)보다 많을 수 없습니다 — 나이를 고치거나 성인을 늘려주세요.</b>`;
  $('#사람말').innerHTML = 말;
  const 확 = $('#사람덮개 .큰버튼');
  if (확) 확.disabled = 넘침;
}

function 사람정하기() {
  if (모달갈래 === '숙박') {
    숙객 = {성인: 임시객.성인, 아이나이: [...임시객.아이나이]};
    임시객 = null; 닫기('사람덮개'); 숙요약갱신(); return;
  }
  여행객 = 임시객; 임시객 = null;
  사람단추갱신(); 닫기('사람덮개'); 요약갱신();
}

/* ─────────────────────────────────────────── 찾기 */
function 조건모으기() {
  const 예 = $('#예산').value.replace('만원 이하', '').trim();
  return {
    출발지이름: $('#출발지').value,
    성인: 여행객.성인, 좌석: 여행객.좌석,
    소아: 소아수(여행객), 유아: 유아수(여행객), 아이나이: [...여행객.아이나이],
    예산만원: /^\d+$/.test(예) ? parseInt(예) : 0,
    직항만: $('#직항만').checked, 주말만: $('#주말만').checked,
    편도: $('#편도').checked, 편도조합: $('#편도조합').checked, 오픈조: $('#오픈조').checked,
    언제: 언제값, 직접기간: [$('#시작날').value, $('#끝날').value],
    며칠: 며칠값(), 고른곳: [...고른곳],
  };
}

/* 찾는 동안 보이는 칸. 엔진이 뱉는 수십 줄을 **한 마디**로 줄여서 보여준다
   (줄이 쌓이는 화면은 손님 눈에 '고장'으로 보인다), 다 찾으면 저 혼자 사라진다. */
let 로그폄 = false, 곁말 = '';

function 비행보이기(켬) {
  const e = $('#비행');
  if (켬) {
    e.classList.remove('사라짐');
    e.style.display = 'block';
    $('#찾는말').textContent = '검색을 준비하고 있습니다';
    $('#찾는곁말').textContent = '';
    $('#진행글').textContent = '';
    $('#로그칸').textContent = '';
    $('#막대').style.display = 'block';
    곁말 = '';
    막대(null);
  } else {
    e.classList.add('사라짐');
    setTimeout(() => { if (!도는중) e.style.display = 'none'; }, 480);
  }
}

function 로그토글() {
  로그폄 = !로그폄;
  $('#로그칸').style.display = 로그폄 ? 'block' : 'none';
  $('#자세히단추').textContent = 로그폄 ? '접기' : '진행 자세히';
}

function 안내갱신(일) {
  const 로그 = 일.로그 || [];
  let 말 = '최저가를 확인하고 있습니다', 단위 = '곳';
  for (const l of 로그) {
    if (l.includes('차례를 기다')) 말 = '앞선 검색이 끝나는 대로 시작합니다';
    if (l.includes('싼 순서로')) 말 = '가격이 낮은 지역부터 확인하고 있습니다';
    const 달 = l.match(/(\d+)곳의 달력을 받습니다/);
    if (달) 말 = `${달[1]}개 도시의 날짜를 확인하고 있습니다`;
    if (l.includes('날짜별로 전부 훑습니다')) 말 = '주요 도시를 날짜별로 확인하고 있습니다';
    if (l.includes('전부 봅니다')) 말 = '선택하신 도시를 날짜별로 확인하고 있습니다';
    if (l.includes('맞춰봅니다')) { 말 = '왕복 조합을 맞춰 보고 있습니다'; 단위 = ''; }
    if (l.includes('다시 확인')) { 말 = '실제 판매가를 재확인하고 있습니다'; 단위 = ''; }
    const 값 = l.match(/^\s*(\S+)\s+갈\s+\d+일.*?최저\s+([\d,]+)원/)
            || l.match(/^\s+(\S+)\s+\d+건\s*·\s*최저\s+([\d,]+)원/);
    if (값) 곁말 = `${값[1]} ${값[2]}원 확인`;
  }
  $('#찾는말').textContent = 말;
  $('#찾는곁말').textContent = 곁말;
  // 🛑 한 단계가 끝나면 다음 단계가 숫자를 줄 때까지 '끝/끝' 이 그대로 남는다.
  //    꽉 찬 막대가 안 움직이면 멈춘 걸로 보인다 — 그럴 땐 흐르는 막대로 돌린다.
  const [끝, 총] = 일.진행 || [0, 0];
  if (총 && 끝 < 총) { 막대(끝 / 총); $('#진행글').textContent = `${끝} / ${총}${단위}`; }
  else { 막대(null); $('#진행글').textContent = ''; }
  $('#로그칸').textContent = 로그.join('\n');
  $('#로그칸').scrollTop = $('#로그칸').scrollHeight;
}

async function 찾기() {
  if (도는중) return;
  /* 🛑 가는 날만 정해진 왕복은 0일짜리 여행이라 서버가 아무것도 못 찾는다 —
     "찾았는데 없습니다" 대신 어디를 눌러야 하는지 알려 준다. */
  if (언제값 === '직접' && !정한날()) {
    $('#상태').textContent = '오는 날을 골라 주세요.';
    달력열기(); return;
  }
  바쁨(true);
  담은 = []; 펼친 = null; 보이는수 = 30; 지역값 = '*'; 달값 = '*';
  비행보이기(true);
  $('#상태').textContent = '';

  let 답;
  try {
    답 = await (await fetch(밑 + 'api/search', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify(조건모으기())
    })).json();
  } catch (e) { 실패('서버에 연결이 안 됩니다.'); return; }

  if (답.잘못) { 실패(답.잘못); return; }
  if (답.바로) { 끝난작업 = 답.작업 || 끝난작업; 결과받음(답.결과, 답.말); return; }
  지금작업 = 답.작업;
  if (답.앞에 > 0) $('#찾는말').textContent =
    `앞에 ${답.앞에}명이 찾고 있어요 — 곧 시작해요`;
  기다리기();
}

function 기다리기() {
  const 작업 = 지금작업;
  const 돌기 = async () => {
    if (지금작업 !== 작업) return;
    let 일;
    try { 일 = await (await fetch(밑 + 'api/job/' + 작업)).json(); }
    catch (e) { setTimeout(돌기, 1500); return; }
    if (일.잘못) { 실패(일.잘못); return; }
    안내갱신(일);
    if (일.상태 === '끝') { 끝난작업 = 작업; 결과받음(일.결과); return; }
    if (일.상태 === '실패') { 실패(일.말); return; }
    setTimeout(돌기, 900);
  };
  돌기();
}

function 막대(값) {
  const m = $('#막대');
  m.style.display = 'block';
  if (값 === null) { m.classList.add('흐름'); $('#막대속').style.width = ''; }
  else { m.classList.remove('흐름'); $('#막대속').style.width = Math.round(값 * 100) + '%'; }
}
function 바쁨(켬) {
  도는중 = 켬;
  $('#찾기버튼').disabled = 켬;
  $('#찾기버튼').textContent = 켬 ? '검색 중…' : '검색';
}
function 실패(말) {
  바쁨(false); 지금작업 = null;
  $('#비행').style.display = 'none';
  $('#상태').textContent = '✗ ' + 말;
}

function 결과받음(결과, 앞말) {
  바쁨(false); 지금작업 = null;
  비행보이기(false);                    // 다 찾았으니 안내 칸은 스스로 사라진다
  줄들 = 결과.줄 || [];
  const 싼 = 결과.제일싼;
  /* 🛑 (2026-08-19) '아시아 53곳 · 미리 찾아 둔 값 · 0.1초 · 특가 12건 · 최저 …' 를 다 뺐다.
     손님이 알고 싶은 건 **몇 개 나왔나**뿐이고 그건 바로 아래 결과 머리가 말한다.
     여기 남는 건 **조건이 바뀌었다는 알림 하나**다 — 없으면 아무 말도 안 한다.
     (없앤 말: 어떻게 찾았나 · 몇 초 걸렸나 · 특가 몇 건 · 최저가 얼마) */
  const 알림 = String(앞말 || '').split('📦')[0].trim().replace(/·$/, '').trim();
  $('#상태').innerHTML = 알림 ? `<b>${홑(알림)}</b>` : '';
  조건접기(false);
  지역칩만들기(); 달칩만들기(); 박칩만들기(); 정렬칩만들기();
  $('#도구줄').style.display = 'flex';
  $('#밑줄').style.display = 줄들.length ? 'flex' : 'none';
  담긴글갱신();
  그리기();
  지역한번펴기();          // 한 번 쫙 폈다가 1.5초 뒤 저 혼자 접힌다 (좁은 화면만)
}

/* ─────────────────────────────────────────── 결과 그리기 */
function 지역칩만들기() {
  const 센다 = {};
  줄들.forEach(r => { const g = r.지역 || '기타'; 센다[g] = (센다[g] || 0) + 1; });
  const 지역들 = Object.keys(센다);
  if (지역들.length < 2) { $('#지역줄').style.display = 'none'; return; }
  /* 어느 나라를 보여줄지는 '많은 순'으로 7개까지 고르고,
     늘어놓는 차례는 위 나라차례(선호도)를 따른다. */
  const 많은순 = 지역들.sort((a, b) => 센다[b] - 센다[a]).slice(0, 7)
    .sort((a, b) => 나라번호(a) - 나라번호(b) || 센다[b] - 센다[a]);
  const 항목 = [['전체', '*', 줄들.length]].concat(많은순.map(g => [g, g, 센다[g]]));
  지역항목 = 항목;
  $('#지역줄').style.display = 'block';
  $('#지역칩').innerHTML = 항목.map(([글, 값, n]) =>
    `<button class="세로칩${값 === 지역값 ? ' 켬' : ''}" data-v="${홑(값)}">
      <span>${홑(글)}</span><i>${n}</i></button>`).join('');
  $('#지역칩').querySelectorAll('.세로칩').forEach(b => b.onclick = () => {
    지역값 = b.dataset.v; 보이는수 = 30; 펼친 = null; 지역칩만들기(); 그리기();
    // 골랐으면 볼 일이 끝났다 — 한 박자 보여주고 도로 접는다
    clearTimeout(지역타이머); 지역타이머 = setTimeout(() => 지역접기(false), 300);
  });
}

/* ── '찾은 곳'은 좁은 화면에서 화면의 절반을 먹는다.
      그래서 결과가 나오면 1.5초만 쫙 펴 보여주고 스르르 접는다. */
function 좁은가() { return window.innerWidth <= 900; }
function 지역요약글() {
  const 짝 = (지역항목 || []).find(([, 값]) => 값 === 지역값);
  return 짝 ? `${짝[0]} ${짝[2]}개` : '';
}
function 지역접기(펼침) { /* 결과 머리로 옮겨 늘 펴져 있다 */ }
function 지역한번펴기() { }
window.addEventListener('resize', () => {
  if (!좁은가()) { clearTimeout(지역타이머); 지역펼침 = true; 지역접기(true); }
});

function 달칩만들기() {
  const 달들 = [...new Set(줄들.map(r => String(r.가는날 || '').slice(0, 6)))].filter(Boolean).sort();
  if (달들.length < 2) { $('#달칩').innerHTML = ''; return; }
  const 항목 = [['월 상관없음', '*']].concat(달들.map(d => [`${parseInt(d.slice(4, 6))}월`, d]));
  $('#달칩').innerHTML = 항목.map(([글, 값]) =>
    `<button class="칩${값 === 달값 ? ' 켬' : ''}" data-v="${값}">${글}</button>`).join('');
  $('#달칩').querySelectorAll('.칩').forEach(b => b.onclick = () => {
    달값 = b.dataset.v; 보이는수 = 30; 펼친 = null; 달칩만들기(); 그리기();
  });
}

/* 며칠 다녀오나는 **찾기 전에 묻지 않고 결과에서 고른다** — 미리 묶으면 싼 걸 놓친다 */
function 박칩만들기() {
  const 박들 = [...new Set(줄들.map(r => r.박).filter(n => n !== null && n !== undefined))]
                .sort((a, b) => a - b);
  if (박들.length < 2) { $('#박칩').innerHTML = ''; 박값 = '*'; return; }
  if (박값 !== '*' && !박들.includes(+박값)) 박값 = '*';
  const 항목 = [['일수 상관없음', '*']].concat(박들.map(n => [`${n}일`, String(n)]));
  $('#박칩').innerHTML = 항목.map(([글, 값]) =>
    `<button class="칩${값 === 박값 ? ' 켬' : ''}" data-v="${값}">${글}</button>`).join('');
  $('#박칩').querySelectorAll('.칩').forEach(b => b.onclick = () => {
    박값 = b.dataset.v; 보이는수 = 30; 펼친 = null; 박칩만들기(); 그리기();
  });
}

/* 🛑 이 목록은 칩과 **결과 머리의 글자**가 같이 쓴다 — 한 자리에 둬야 둘이 안 어긋난다 */
const 정렬항목 = [['최저가순', '값'], ['특가순', '특가'], ['절약순', '절약'], ['출발일순', '날짜']];
const 정렬글 = v => (정렬항목.find(x => x[1] === v) || 정렬항목[0])[0];

function 정렬칩만들기() {
  $('#정렬칩').innerHTML = 정렬항목.map(([글, 값]) =>
    `<button class="칩${값 === 정렬값 ? ' 켬' : ''}" data-v="${값}">${글}</button>`).join('');
  $('#정렬칩').querySelectorAll('.칩').forEach(b => b.onclick = () => {
    정렬값 = b.dataset.v; 보이는수 = 30; 펼친 = null; 정렬칩만들기(); 그리기();
  });
}

/* ── 조건 접이 (항공) — 지역·월·일수 칩을 접어 둔다.
   🛑 접어 두면 "내가 뭘 걸어 놨는지" 를 잃는다. 그래서 걸린 조건은 단추 이름에 적는다. */
let 조건폄 = false;
function 조건칩접기(켤까) {
  조건폄 = (켤까 === undefined) ? !조건폄 : !!켤까;
  $('#조건속').classList.toggle('폄', 조건폄);
  $('#조건단추').classList.toggle('켬', 조건폄);
}
function 조건줄임(건) {          // 두 개까지만 적는다 — 세 개를 다 적으면 머리가 두 줄이 된다
  if (!건.length) return '조건';
  return '조건 · ' + (건.length <= 2 ? 건.join(' · ') : `${건[0]} 외 ${건.length - 1}`);
}
function 조건단추갱신() {
  const 건 = [지역값 === '*' ? '' : 지역값,
              달값 === '*' ? '' : `${parseInt(달값.slice(4, 6))}월`,
              박값 === '*' ? '' : `${박값}일`].filter(Boolean);
  $('#조건단추').innerHTML = 홑(조건줄임(건)) + ' <i>▾</i>';
}

function 날짜보기(d) {
  if (!d) return '-';
  const s = String(d), y = +s.slice(0,4), m = +s.slice(4,6), dd = +s.slice(6,8);
  const 요일 = '일월화수목금토'[new Date(y, m-1, dd).getDay()];
  return `${m}/${dd}(${요일})`;
}
function 열쇠(r) { return [r.코드, r.가는날, r.오는날 || null]; }
function 담겼나(r) { return 담은.some(x => JSON.stringify(열쇠(x)) === JSON.stringify(열쇠(r))); }
function 가는법(r) {
  if (r.종류 === '편도조합') return '편도 2장 따로 사기';
  if (r.종류 === '오픈조') return `${(r.가는편||{}).도시||''} IN · ${(r.오는편||{}).도시||''} OUT`;
  return '';
}
function 보일값(r) { return r.확인값 || r.가격 || 0; }

function 그리기() {
  계획보이기();
  let 목 = 줄들.slice();
  if (지역값 !== '*') 목 = 목.filter(r => (r.지역 || '기타') === 지역값);
  if (달값 !== '*') 목 = 목.filter(r => String(r.가는날 || '').startsWith(달값));
  if (박값 !== '*') 목 = 목.filter(r => String(r.박) === 박값);
  // 줄세우기도 **실제로 살 수 있는 값**으로 한다 (확인이 끝난 줄은 그 값이 진짜다)
  if (정렬값 === '날짜') 목.sort((a, b) => (a.가는날 - b.가는날) || (보일값(a) - 보일값(b)));
  else if (정렬값 === '특가') 목.sort((a, b) => (b.점수 - a.점수) || (보일값(a) - 보일값(b)));
  else if (정렬값 === '절약') 목.sort((a, b) => ((b.절약||0) - (a.절약||0)) || (보일값(a) - 보일값(b)));
  else 목.sort((a, b) => 보일값(a) - 보일값(b));
  보임 = 목;

  /* 🛑 (2026-08-19) 결과 머리는 **두 마디**다 — 총 몇 개인가, 무슨 순서인가.
     고른 조건(지역·월·일수)은 여기 늘어놓지 않고 [조건] 단추 이름으로 간다. */
  $('#결과글').textContent = 목.length
    ? `총 ${목.length}개 · ${정렬글(정렬값)}` : '결과 없음';
  조건단추갱신();

  if (!목.length) {
    빈화면('조건에 맞는 항공권이 없습니다 — 기간이나 예산을 넓혀 보세요');
    return;
  }
  const 싼값 = Math.min(...목.map(r => 보일값(r)));
  $('#목록').innerHTML = 목.slice(0, 보이는수).map((r, i) => 카드(r, i, 싼값)).join('')
    + (목.length > 보이는수
       ? `<div style="text-align:center;padding:8px"><button class="연버튼" id="더보기">
          ＋ ${목.length - 보이는수}개 더 보기</button></div>` : '');
  $('#목록').querySelectorAll('[data-펼침]').forEach(e =>
    e.onclick = () => { const i = +e.dataset.펼침; 펼친 = (펼친 === i) ? null : i; 그리기(); });
  $('#목록').querySelectorAll('[data-담기]').forEach(e =>
    e.onclick = ev => { ev.stopPropagation(); 담기(+e.dataset.담기); });
  $('#목록').querySelectorAll('[data-숙소]').forEach(e =>
    e.onclick = ev => { ev.stopPropagation(); 숙소찾기(+e.dataset.숙소); });
  const 더 = $('#더보기');
  if (더) 더.onclick = () => { 보이는수 += 30; 그리기(); };
}

function 카드(r, i, 싼값) {
  const 법 = 가는법(r);
  const 딱지 = (r.특가 ? `<span class="딱지 특가">특가 · 평균가 대비 ${r.할인}% 낮음</span>` : '')
    + (r.가격 === 싼값 ? `<span class="딱지 싼">최저가</span>` : '')
    + (법 ? `<span class="딱지 법">${홑(법)}</span>` : '');
  const 정보 = [
    날짜보기(r.가는날) + (r.오는날 ? ' → ' + 날짜보기(r.오는날) : '') +
