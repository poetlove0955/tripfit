function 숙정렬칩만들기() {
  const 추 = 숙줄들.filter(r => (r.추천등급 || 0) > 0).length;
  const 항목 = 숙정렬항목.map(([g, v]) =>
    [v === '추천' && 추 ? `${g} ${추}` : g, v]);
  $('#숙정렬칩').innerHTML = 항목.map(([g, v]) =>
    `<button class="칩${v === 숙정렬값 ? ' 켬' : ''}${v === '추천' ? ' 추천칩' : ''}"
             data-v="${v}">${홑(g)}</button>`).join('');
  $('#숙정렬칩').querySelectorAll('.칩').forEach(b => b.onclick = () => {
    숙정렬값 = b.dataset.v; 숙보이는수 = 30; 숙정렬칩만들기(); 숙그리기();
  });
}
/* 종류 칩 — 몸통을 누르면 '그것만', [✕] 를 누르면 '그건 빼고'.
   같은 칩에 두 손잡이를 단 이유: 손님이 보는 목록에 세어 놓은 숫자가 여기 있어서,
   왼쪽 칸까지 눈을 옮기지 않고 그 자리에서 뺄 수 있어야 한다. */
function 숙종류칩만들기() {
  const 센다 = {};
  숙줄들.forEach(r => { const t = r.종류 || '기타'; 센다[t] = (센다[t] || 0) + 1; });
  const 많은순 = Object.keys(센다).sort((a, b) => 센다[b] - 센다[a]).slice(0, 8);
  if (많은순.length < 2) { $('#숙종류칩').innerHTML = ''; 숙뺀줄그리기(); return; }
  $('#숙종류칩').innerHTML =
    `<button class="칩${숙종류값 === '*' ? ' 켬' : ''}" data-v="*">전체</button>`
    + 많은순.map(t =>
      `<button class="칩${t === 숙종류값 ? ' 켬' : ''}${숙제외.has(t) ? ' 뺀' : ''}"
               data-v="${홑(t)}">${홑(t)} ${센다[t]}<span class="엑스" data-뺄="${홑(t)}"
               title="${숙제외.has(t) ? '도로 넣기' : '이 종류는 빼고 보기'}"
               >${숙제외.has(t) ? '↺' : '✕'}</span></button>`).join('');
  $('#숙종류칩').querySelectorAll('.칩').forEach(b => b.onclick = e => {
    const 뺄 = e.target.dataset && e.target.dataset.뺄;
    if (뺄) { e.stopPropagation(); 숙제외.has(뺄) ? 숙되돌리기(뺄) : 숙빼기(뺄); return; }
    숙종류값 = b.dataset.v; 숙보이는수 = 30; 숙종류칩만들기(); 숙그리기();
  });
  숙뺀줄그리기();
}
function 숙뺀줄그리기() {
  const e = $('#숙뺀줄');
  if (!숙제외.size) { e.style.display = 'none'; e.innerHTML = ''; return; }
  e.style.display = 'flex';
  e.innerHTML = `<b>✕ 빼고 보는 중</b>`
    + [...숙제외].map(t =>
        `<button class="연버튼" style="padding:3px 9px;font-size:12px"
                 data-되돌="${홑(t)}">${홑(t)} ↺</button>`).join('')
    + `<button class="연버튼" style="padding:3px 9px;font-size:12px"
               data-비움="1">전부 도로 넣기</button>`;
  e.querySelectorAll('[data-되돌]').forEach(b =>
    b.onclick = () => 숙되돌리기(b.dataset.되돌));
  e.querySelector('[data-비움]').onclick = 숙제외비우기;
}
function 숙지역칩만들기() {
  const 센다 = {};
  숙줄들.forEach(r => { const g = r.목적지 || '기타'; 센다[g] = (센다[g] || 0) + 1; });
  const 곳들 = Object.keys(센다);
  if (곳들.length < 2) { $('#숙지역줄').style.display = 'none'; return; }
  const 많은순 = 곳들.sort((a, b) => 센다[b] - 센다[a]).slice(0, 12);
  const 항목 = [['전체', '*', 숙줄들.length]].concat(많은순.map(g => [g, g, 센다[g]]));
  $('#숙지역줄').style.display = 'block';
  $('#숙지역칩').innerHTML = 항목.map(([글, 값, n]) =>
    `<button class="세로칩${값 === 숙곳값 ? ' 켬' : ''}" data-v="${홑(값)}">
      <span>${홑(글)}</span><i>${n}</i></button>`).join('');
  $('#숙지역칩').querySelectorAll('.세로칩').forEach(b => b.onclick = () => {
    숙곳값 = b.dataset.v; 숙보이는수 = 30; 숙지역칩만들기(); 숙그리기();
  });
}
let 숙곳값 = '*';

/* ── 목록 */
const 숙추천머리 = {
  1: ['4성급 이상 · 가격이 낮은 곳', '흔치 않은 조합입니다'],
  2: ['가격이 낮은 곳', '1인 침대 요금·후기 없는 곳은 제외했습니다'],
  3: ['시설과 후기가 모두 좋은 곳', '후기가 충분히 쌓인 곳만'],
  4: ['역·번화가에서 가까운 곳', ''],
  9: ['그 밖의 곳', '가성비 순'],
};

/* 🛑 추천 문구는 **엔진(숙박검색.py)이 미리 적어 둔 말**이라 화면에서 못 고친다.
   엔진을 고쳐도 이미 만들어 둔 묶음에는 옛 말이 그대로 남는다 → 화면에 내보내기 직전에
   말투만 다듬는다. 뜻은 건드리지 않는다(숫자·대상은 그대로). */
const 말다듬기 = t => String(t == null ? '' : t)
  .replace(/(\d+)% 싸다/g, '$1% 낮음')
  .replace(/(\d+)원 싸다/g, '$1원 낮음')
  .replace(/인데 싸다/g, '인데 가격이 낮다')
  .replace(/값이 눈에 띄게 싸다/g, '가격이 눈에 띄게 낮다')
  .replace(/싼데 평이 좋다/g, '가격 대비 평가가 좋다')
  .replace(/싼 쪽 (\d+)%/g, '하위 $1% 가격')
  .replace(/보통값/g, '평균가')
  .replace(/평 (\d)/g, '평점 $1');

function 숙그리기() {
  let 목 = 숙줄들.slice();
  if (숙곳값 !== '*') 목 = 목.filter(r => r.목적지 === 숙곳값);
  if (숙종류값 !== '*') 목 = 목.filter(r => (r.종류 || '기타') === 숙종류값);
  if (숙제외.size) 목 = 목.filter(r => !숙제외.has(r.종류 || '기타'));
  const 뺀수 = (숙곳값 === '*' && 숙종류값 === '*') ? 숙줄들.length - 목.length : 0;

  if (숙정렬값 === '추천') {
    // 🛑 추천은 **점수 하나로 줄 세우는 게 아니다.** 등급이 먼저고 점수는 그 안에서만
    //    본다. 4순위 100점이 1순위 30점보다 위에 서면 순위라는 말이 뜻을 잃는다.
    // 🛑 그리고 **아무것도 감추지 않는다.** 순위에 못 든 곳은 사라지는 게 아니라
    //    맨 아래 [그 밖의 곳] 으로 내려간다 — 숨기면 손님은 목록이 고장난 줄 안다.
    목 = 목.map(r => Object.assign(r, {_급: (r.추천등급 || 0) > 0 ? r.추천등급 : 9}))
           .sort((a, b) => a._급 - b._급
                        || (b.추천점수 || 0) - (a.추천점수 || 0)
                        || b.가성비 - a.가성비);
  } else {
    const 자 = {가성비: r => -r.가성비, 값: r => r['1박'], 특가: r => -(r.딜점수 || 0),
                후기: r => -(r.후기 || 0), 위치: r => (r.가까운곳?.미터 ?? 99999)}[숙정렬값];
    목.sort((a, b) => 자(a) - 자(b) || a['1박'] - b['1박']);
  }
  숙보임 = 목;

  $('#숙결과글').textContent = 목.length
    ? `총 ${목.length}곳 · ${숙정렬글(숙정렬값)}` : '결과 없음';
  숙조건단추갱신();
  if (!목.length) {
    숙빈화면('조건에 맞는 숙소가 없습니다 — 예산이나 후기 조건을 넓혀 보세요');
    return;
  }

  let 글 = '', 앞등급 = 0;
  // 순위가 하나도 안 붙은 목록(옛 결과가 남아 있는 경우)이면 머리글을 달지 않는다 —
  // 안 그러면 [그 밖의 곳] 한 줄만 덩그러니 뜬다
  const 머리달까 = 숙정렬값 === '추천' && 추천수 > 0;
  if (숙정렬값 === '추천' && !추천수) {
    글 += `<div class="추천머리" style="color:var(--연보조)">
      순위를 매길 자료가 없는 목록입니다 — 다시 검색해 주세요<i></i></div>`;
  }
  목.slice(0, 숙보이는수).forEach(r => {
    if (머리달까 && r._급 !== 앞등급) {
      앞등급 = r._급;
      const [제, 곁] = 숙추천머리[앞등급] || ['', ''];
      글 += `<div class="추천머리">${앞등급 === 9 ? '' : 앞등급 + '순위 · '}${홑(제)}
               ${곁 ? `<span>${홑(곁)}</span>` : ''}<i></i></div>`;
    }
    글 += 숙카드(r);
  });
  $('#숙목록').innerHTML = 글
    + (목.length > 숙보이는수
       ? `<div style="text-align:center;padding:8px"><button class="연버튼" id="숙더보기">
          ＋ ${목.length - 숙보이는수}개 더 보기</button></div>` : '');
  const 더 = $('#숙더보기');
  if (더) 더.onclick = () => { 숙보이는수 += 30; 숙그리기(); };
}

function 숙빈화면(말) {
  $('#숙목록').innerHTML = `<div class="빈"><div class="큰">🏨</div>
    <div style="margin-top:14px">${홑(말 || '조건을 고르고 검색해 주세요')}</div></div>`;
}

function 숙카드(r) {
  const 후 = r.후기 || 0, 후수 = r.후기수 || 0;
  const 후기알 = 후수 > 0
    ? `<span class="후기알${후 < 7.5 ? ' 낮' : ''}">${후.toFixed(1)}</span>
       <span class="조각" style="font-size:12px;color:var(--연보조)">후기 ${돈(후수)}개</span>`
    : `<span class="후기알 없">후기 없음</span>`;
  const 별 = r.별 >= 1 ? `<span class="조각" style="color:var(--금)">★ ${r.별}성급</span>` : '';
  const 역 = r.가까운곳 && r.가까운곳.미터
    ? `<span class="조각">🚉 ${홑(r.가까운곳.이름)} ${돈(r.가까운곳.미터)}m</span>` : '';
  const 딱지 = [
    r.특가 ? `<span class="딱지 특가">특가${r.특가이유 ? ' · ' + 홑(말다듬기(r.특가이유)) : ''}</span>` : '',
    r.숙소할인 >= 10 ? `<span class="딱지 좋">정가 대비 ${r.숙소할인}% 낮음</span>` : '',
    r.무료취소 ? `<span class="딱지 좋">무료 취소</span>` : '',
    r.침대값섞임 ? `<span class="딱지 흐림">1인 침대 요금일 수 있습니다</span>` : '',
    r.같은곳 ? `<span class="딱지 흐림">같은 값 방 ${r.같은곳}개</span>` : '',
    r.날모름 ? `<span class="딱지 흐림">날짜 비교 없음</span>` : '',
  ].filter(Boolean).join('');
  const 예약 = Object.entries(r.예약 || {});
  const 사진 = r.사진
    ? `<img class="숙사진" src="${홑(r.사진)}" alt="" loading="lazy"
            onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'숙사진 빔',textContent:'🏨'}))">`
    : `<div class="숙사진 빔">🏨</div>`;

  const 급 = r.추천등급 || 0;
  const 추천 = 급
    ? `<span class="추천딱 급${급}">${급}순위 · ${홑(말다듬기(r.추천이름))}</span>` : '';
  const 추천말 = (급 && r.추천말)
    ? `<div class="추천말">${급 === 1 ? '<b>' : ''}${홑(말다듬기(r.추천말))}${급 === 1 ? '</b>' : ''}</div>` : '';
  // 두 집 값을 견줘 봤을 때. 🛑 차이가 크면 같은 방이 아닐 수 있어 단정하지 않는다.
  const 딴 = r.딴곳값 || {};
  const 견줌 = Object.keys(딴).length > 1
    ? `<div class="견줌">` + Object.entries(딴)
        .sort((a, b) => a[1] - b[1])
        .map(([k, v], i) => i === 0
          ? `${홑(k)} <b>${돈(v)}원</b>`
          : ` · ${홑(k)} <s>${돈(v)}원</s>`).join('')
      + (r.값차이믿음 && r.아낀값 > 0
         ? ` — <b>${돈(r.아낀값)}원 낮음</b>`
         : ` <span style="color:var(--연보조)">(객실 조건이 다를 수 있습니다)</span>`)
      + `</div>`
    : '';

  return `<div class="카드${급 === 1 ? ' 으뜸' : ''}"><div class="숙카드">
    ${사진}
    <div class="숙속">
      ${추천 ? `<div class="숙딱지줄" style="margin:0 0 5px">${추천}</div>` : ''}
      <a class="숙이름" href="${홑((예약[0] || [])[1] || '#')}" target="_blank" rel="noopener"
         >${홑(r.이름)}</a>
      <div class="숙줄">
        <span class="조각" style="color:var(--브랜드);font-weight:700">${홑(r.목적지)}</span>
        ${r.동네 ? `<span class="조각">${홑(r.동네)}</span>` : ''}
        ${r.종류 ? `<span class="조각">${홑(r.종류)}</span>` : ''}${별}
        ${r.곳 ? `<span class="곳딱">${홑(r.곳)}</span>` : ''}
      </div>
      <div class="숙줄">${후기알}${역}</div>
      ${추천말}
      <div class="가성비줄">
        <div class="가성비막대"><i style="width:${Math.max(3, Math.min(100, r.가성비))}%"></i></div>
        <span class="가성비글">가성비 <b>${r.가성비}</b> ·
          이 도시 하위 ${r.값자리}% 가격</span>
      </div>
      ${견줌}
      <div class="숙딱지줄">${딱지}</div>
    </div>
    <div class="숙값칸">
      <div class="숙값">${돈(r['1박'])}원</div>
      <div class="숙값밑">1박 · 세금·수수료 포함<br>
        ${typeof r.총액 === 'number'
            ? `${홑(r.셈단위 || (r.박 + '박'))} 합계 <b>${돈(r.총액)}원</b>`
            : `${r.박}박 합계는 확인되지 않았습니다`}</div>
      <div class="숙단추줄">
        ${예약.map(([k, v]) =>
          `<a class="연버튼 살버튼" href="${홑(v)}" target="_blank" rel="noopener"
              style="text-decoration:none">${홑(k)} ↗</a>`).join('')}
      </div>
    </div>
  </div></div>`;
}

