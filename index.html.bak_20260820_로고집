async function 콘텐츠(종류) {
  if (!줄들.length || !끝난작업) { alert('먼저 항공권을 찾아주세요.'); return; }
  $('#글제목').textContent = {문구: '📋 문구 (인스타·스레드·카톡에 그대로)',
    블로그: '📝 블로그 글 (.md)', 인스타: '📷 인스타 카드 (1080×1350)'}[종류];
  $('#글속').innerHTML = '<div style="padding:30px;text-align:center;color:var(--연보조)">만드는 중…</div>';
  $('#내려받기').style.display = 'none';
  $('#복사버튼').style.display = (종류 === '인스타') ? 'none' : '';
  열기('글덮개');

  const 담긴 = (담은.length ? 담은 : 보임.slice(0, 40)).map(열쇠);
  let 답;
  try {
    답 = await (await fetch(밑 + 'api/content', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({작업: 끝난작업, 종류: 종류, 담은: 담긴})
    })).json();
  } catch (e) { $('#글속').textContent = '만들지 못했습니다.'; return; }

  if (답.잘못) { $('#글속').innerHTML = `<div style="color:var(--빨강)">${홑(답.잘못)}</div>`; return; }
  마지막글 = 답.글 || '';
  if (종류 === '인스타') {
    $('#글속').innerHTML = `<img src="${밑}file/${홑(답.파일)}"
      style="max-width:100%;border:1px solid var(--테두리);border-radius:10px">`;
  } else {
    $('#글속').innerHTML = `<textarea readonly style="width:100%;height:52vh;border:1px solid var(--진테두리);
      border-radius:10px;padding:12px;font-size:14px;line-height:1.6;font-family:inherit">${홑(답.글 || '')}</textarea>`;
  }
  if (답.파일) { $('#내려받기').href = 밑 + 'file/' + 답.파일; $('#내려받기').style.display = ''; }
}
function 글복사() {
