  }

  /* 곳마다 값이 어떤 값인가. 네 가지가 있고, 넷이 다 달라 보여야 한다.
       ① 물어봐서 확인한 값      진한 글씨
       ② 네이버 달력값          흐린 글씨 + 점선 — **물어본 값이 아니다**
       ③ 못 믿을 값이라 뺀 곳    ⚠ + 붉은 테두리 (왜 뺐는지는 손 올리면 나온다)
       ④ 아예 안 물어본 곳       동그라미 하나
     🛑 8/11 요나고: ②를 ④처럼 그려 놓고 밑에 "값이 안 붙은 곳은 안 물어본 곳"이라
        적었다. 카드값이 바로 그 네이버에서 온 값인데 안 물어봤다고 적힌 것이다.
        화면이 아는 것을 숨기면, 화면이 거짓말을 한다. */
  const 교 = r.교차 || null;
  const 곳값 = (교 && 교.값들) || {};
  const 막힌곳 = (교 && 교.막힘) || {};
  const 값찾기 = k => 곳값[k] ?? (k.endsWith(' 직판') ? 곳값['직판'] : undefined);
  const 막힌왜 = k => 막힌곳[k] ?? (k.endsWith(' 직판') ? 막힌곳['직판'] : undefined);

