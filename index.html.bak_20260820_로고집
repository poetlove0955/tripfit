/* 코드 편집기는 딴 쪽(/edit)에 있다 — 이 화면과 섞으면 손님이 헷갈린다 */
function 편집창() { window.open(밑 + 'edit', '_blank'); }


/* ══════════════════════════════════════════════════════════ ⭐ BEST
   「오늘의 특가 10」 — 나라마다 한 장씩 깔고, 자리가 남으면 **평소보다 유난히 싼**
   나라에서 다른 날짜로 채워 열 장을 만든다.

   ⭐ 줄 세우는 자는 값이 아니라 **평소 대비 얼마나 내려갔나**(할인)다.
      값으로 세우면 늘 같은 두어 나라만 열 장을 다 차지한다 — 볼 이유가 없어진다.
   🛑 여기엔 조건 칸이 없다. 고르는 자리가 아니라 **보여 주는 자리**다.
      (고르고 싶은 손님에게는 [항공권] 탭이 있다)
   🛑 배너 한 장이 통째로 링크다. 안에 또 단추를 두지 않는다 — 어디를 눌러야 하는지가
      손님의 숙제가 되면 안 된다.                                                */
let 베도는중 = false, 베줄들 = [], 베깼나 = false;

/* 나라 표시. 🛑 국기 이모지(🇯🇵)는 **윈도우에서 글자 두 개('JP')로 나온다** —
   폰에서만 예쁘고 PC 에서는 깨져 보인다. 어디서나 그려지는 그림만 쓴다. */
const 베그림 = {일본:'🗾', 베트남:'🌴', 태국:'🐘', 대만:'🧋', 홍콩:'🌃', 마카오:'🎰',
                중국:'🏯', 필리핀:'🏝', 싱가포르:'🦁', 말레이시아:'🌺', 인도네시아:'🌋',
                라오스:'🛕', 몽골:'🐎', 괌:'🏖', 사이판:'🐠'};
const 베값 = r => r.확인값 || r.가격 || 0;
const 베내림 = r => Math.max(0, +r.할인 || 0);
/* 채워 넣을 때의 문턱. 그냥 '두 번째로 싼 것'이 아니라 **유난히 싼 것**만 들어온다. */
const 베더넣기문턱 = 15;

function 베스트깨우기() {
  if (베깼나) return;
  베깼나 = true;
  베스트찾기();
}

/* 서버가 바로 답할 때(미리 찾아 둔 값)와 오래 걸릴 때(집 PC 가 직접 훑는다)를
   한 함수 안에서 같게 만든다. */
async function 한번검색(길, 몸) {
  const 답 = await (await fetch(밑 + 길, {
    method: 'POST', headers: {'Content-Type': 'application/json'},
    body: JSON.stringify(몸)
  })).json();
  if (답.잘못) throw new Error(답.잘못);
  if (답.바로) return {결과: 답.결과, 말: 답.말 || ''};
  for (let i = 0; i < 400; i++) {
    await new Promise(r => setTimeout(r, 1000));
    const 일 = await (await fetch(밑 + 'api/job/' + 답.작업)).json();
    if (일.잘못) throw new Error(일.잘못);
    if (일.상태 === '끝') return {결과: 일.결과, 말: 일.말 || ''};
    if (일.상태 === '실패') throw new Error(일.말 || '자료를 받지 못했습니다');
  }
  throw new Error('시간이 너무 오래 걸립니다');
}

async function 베스트찾기() {
  if (베도는중) return;
  베바쁨(true);
  $('#베목록').innerHTML = '';
  $('#베상태').textContent = '';
  try {
    /* 🛑 며칠 [1,10] 은 넓은 칸(항공_*_왕복_1-10)과 짝이다 — 좁게 물으면
       나라 절반이 통째로 사라져 '나라마다 한 장'이 성립하지 않는다. */
    const 항 = await 한번검색('api/search', {
      출발지이름: ($('#출발지') && $('#출발지').value) || (메타.출발지 || ['서울'])[0],
      성인: 1, 좌석: '일반석', 소아: 0, 유아: 0, 아이나이: [],
      예산만원: 0, 직항만: false, 주말만: false,
      편도: false, 편도조합: false, 오픈조: false,
      언제: '여섯달', 직접기간: ['', ''], 며칠: [1, 10], 고른곳: [],
    });
    베고르기(항.결과.줄 || []);
    $('#베상태').textContent =
      String(항.말 || '').split('📦')[0].trim().replace(/·$/, '').trim();
  } catch (e) {
    $('#베상태').textContent = '✗ ' + e.message;
    베빈화면('잠시 뒤 다시 열어 주세요');
  } finally {
    베바쁨(false);
  }
}

function 베고르기(줄) {
  const 나라별 = {};
  줄.forEach(r => {
    if (!r.나라 || !r.목적지 || 베값(r) <= 0) return;
    /* 🛑 편도 2장 조합·오픈조는 여기 못 온다. 배너 하나가 곧 링크 하나인데,
       편도 조합은 표가 둘이라 **한 번 눌러서는 그 값을 못 산다** — 값만 보여 주고
       갈 데가 없는 배너는 화면이 거짓말하는 자리다. (조합은 [항공권] 탭에서 본다)
       나라 15곳 모두 왕복 줄이 있어, 걸러도 빠지는 나라가 없다(실측). */
    if (r.종류 !== '왕복') return;
    (나라별[r.나라] = 나라별[r.나라] || []).push(r);
  });
  // 나라 안에서는 '많이 내려간 것 → 그다음 싼 것' 차례
  Object.values(나라별).forEach(v =>
    v.sort((a, b) => 베내림(b) - 베내림(a) || 베값(a) - 베값(b)));

  const 나라차 = Object.keys(나라별)
    .sort((a, b) => 베내림(나라별[b][0]) - 베내림(나라별[a][0]));

  /* 🛑 같은 나라를 같은 날로 또 담으면 열 장이 아니라 다섯 장이 된다.
     열쇠를 「나라|가는날」 로 잡아 **채울 때는 반드시 다른 날짜**가 되게 한다. */
  const 쓴것 = new Set(), 뽑음 = [];
  const 담기 = r => {
    const 열 = r.나라 + '|' + r.가는날;
    if (쓴것.has(열)) return false;
    쓴것.add(열); 뽑음.push(r); return true;
  };

  // ① 나라마다 한 장 — 이게 열 장의 바탕이다
  나라차.forEach(n => { if (뽑음.length < 10) 담기(나라별[n][0]); });

  // ② 자리가 남으면 유난히 싼 나라에서 다른 날짜로 채운다
  for (let 바퀴 = 1; 뽑음.length < 10 && 바퀴 < 12; 바퀴++) {
    let 더함 = false;
    for (const n of 나라차) {
      if (뽑음.length >= 10) break;
      const 후 = 나라별[n][바퀴];
      if (!후 || 베내림(후) < 베더넣기문턱) continue;
      if (담기(후)) 더함 = true;
    }
    if (!더함) break;
  }

  베줄들 = 뽑음.sort((a, b) => 베내림(b) - 베내림(a) || 베값(a) - 베값(b));
  베그리기();
}

function 베빈화면(말) {
  $('#베목록').innerHTML = `<div class="빈"><div class="큰">⭐</div>
    <div style="margin-top:14px">${홑(말)}</div></div>`;
}

function 베그리기() {
  if (!베줄들.length) {
    베빈화면('오늘은 내놓을 만한 특가가 없습니다 — 값이 갱신되면 다시 채워집니다');
    return;
  }
  const 나라수 = new Set(베줄들.map(r => r.나라)).size;
  $('#베목록').innerHTML =
    `<div class="베머리글"><b>오늘의 특가 ${베줄들.length}</b>
       <span>${나라수}개 나라 · 왕복 1인 · 평소보다 많이 내려간 순</span></div>`
    + 베줄들.map((r, i) => 베배너(r, i)).join('')
    + `<div class="베주">배너를 누르면 그 항공권 예약 화면으로 갑니다.
        값은 갱신 시각 기준이며, 최종 금액은 예약처에서 확인해 주세요.</div>`;
}

function 베띠색(내림) {
  return 내림 >= 40 ? '#e8590c' : 내림 >= 25 ? '#b7791f' : 'var(--브랜드밝)';
}

function 베배너(r, i) {
  const 곳 = ((r.예약 || [])[0] || {}).곳 || {};
  const 주소 = 곳['네이버'] || Object.values(곳)[0] || '';
  const 값 = 베값(r), 내림 = 베내림(r);
  const 잔 = [(r.박 !== null && r.박 !== undefined) ? `${r.박}박` : '',
              r.경유 === 0 ? '직항' : (r.경유 ? `경유 ${r.경유}회` : ''),
              홑((r.항공사 || '').split(',')[0].trim())].filter(Boolean).join(' · ');
  const 날 = 날짜보기(r.가는날) + (r.오는날 ? ' → ' + 날짜보기(r.오는날) : '');
  return `<a class="베배너${i === 0 ? ' 으뜸' : ''}" style="--띠:${베띠색(내림)}"
    href="${홑(주소)}" target="_blank" rel="noopener"
    title="${홑(r.목적지)} ${홑(날)} — 예약 화면으로 갑니다">
    <span class="베번">${i + 1}</span>
    <span class="베깃">${베그림[r.나라] || '✈'}</span>
    <span class="베속">
      <span class="베도시">${홑(r.목적지)}</span><span class="베나라">${홑(r.나라 || '')}</span>
      <span class="베날">${홑(날)}${잔 ? ' · ' + 잔 : ''}</span>
    </span>
    <span class="베돈">
      ${내림 ? `<span class="베내림">평소보다 ${내림}%↓</span>` : ''}
      <b>${돈(값)}원</b>
      ${(r.평소 && 내림) ? `<s>${돈(r.평소)}원</s>` : ''}
    </span>
    <span class="베화">›</span>
  </a>`;
}

function 베바쁨(켬) {
  베도는중 = 켬;
  const e = $('#베비행');
  if (켬) { e.classList.remove('사라짐'); e.style.display = 'block'; }
  else { e.classList.add('사라짐'); setTimeout(() => { if (!베도는중) e.style.display = 'none'; }, 480); }
}

/* ══════════════════════════════════════════════════════════ 🧳 내 여행 계획
   손님이 「언제 · 어디로」 를 적어 두면, 그 기간의 값이 내려갔을 때 카톡으로 알린다.

   ⭐ 왜 첫 화면 아래인가
      조건을 안 고른 손님에게 [조건을 고르고 검색해 주세요] 만 보여 주면 화면이 죽는다.
      "지금은 안 살 건데 싸지면 알려줘" 가 여행 손님의 진짜 마음이다.

   🛑 로그인 벽을 세우지 않는다. 계획은 로그인 없이도 적히고(이 컴퓨터에), 문이 열리는 건
      **[🔔] 을 누르는 그 순간** 하나뿐이다 — 카톡을 보내려면 누군지 알아야 하니까.
   🛑 카톡 보내기 동의는 **로그인할 때 같이 받지 않는다.** 값만 보러 온 손님에게
      처음부터 「메시지 보내기」 동의를 들이밀면 3초가 30초가 된다. 켤 때 그 자리에서 받는다.
   🛑 8773(집 PC 대표용)에는 로그인 창구가 없다 — 그때는 이 칸이 **이 컴퓨터에만** 적힌다. */
const 계획최대 = 3;
let 계획들 = [], 계획중 = null, 계획고침 = -1, 계획카톡 = false;

const 들어왔나 = () => !!(window.트립핏 && 트립핏.들어왔나 && 트립핏.들어왔나());
const 로그인있나 = () => !!(window.트립핏 && 트립핏.로그인문);
/* 🛑 로그인 조각이 붙어 있는 것과 **문이 실제로 열려 있는 것**은 다르다.
   카카오 키를 안 넣었으면 로그인 창은 아무것도 안 그리고 조용히 돌아간다 —
   그때 우리가 아무 말도 안 하면 손님은 [🔔] 이 고장 난 줄 안다. */
const 문열렸나 = () => {
  try { return !!(window.트립핏 && 트립핏.나 && (트립핏.나().문 || []).length); }
  catch (e) { return false; }
};

function 계획시작() {
  try { 계획들 = JSON.parse(localStorage.getItem('TF계획') || '[]') || []; }
  catch (e) { 계획들 = []; }
  if (!Array.isArray(계획들)) 계획들 = [];
  계획들 = 계획들.slice(0, 계획최대);
  계획그리기();
  계획내려받기();
  /* 로그인 상태가 바뀌면(들어오면) 서버에 적힌 것과 맞춘다 */
  addEventListener('트립핏로그인', 계획내려받기);
}

function 계획적기() {
  계획들 = 계획들.slice(0, 계획최대);
  try { localStorage.setItem('TF계획', JSON.stringify(계획들)); } catch (e) {}
  계획올리기();
  계획그리기();
}

/* 서버(KV)에도 둔다 — **카톡을 보내는 쪽이 읽을 자리**다.
   🛑 안 들어와 있으면 여기서 조용히 아무 일도 안 한다 (403 을 손님에게 보일 이유가 없다). */
let 계획올림표 = 0;
function 계획올리기() {
  if (!들어왔나()) return;
  /* 🛑 종을 딸깍거릴 때마다 서버 장부에 쓰면 **무료 한도(하루 쓰기 1,000번)** 를 그냥
     태운다. 1.2초로 묶어 마지막 한 번만 올린다. */
  clearTimeout(계획올림표);
  계획올림표 = setTimeout(계획정말올리기, 1200);
}

function 계획정말올리기() {
  clearTimeout(계획올림표);
  계획올림표 = 0;
  if (!들어왔나()) return;
  fetch('/api/plan', {
    method: 'POST', headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({계획: 계획들}), keepalive: true,
  }).catch(() => {});
}

/* 🛑 묶어 두면 **창이 닫히는 순간이 위험하다** — 아직 안 올라간 것은 그대로 사라진다. */
addEventListener('pagehide', () => { if (계획올림표) 계획정말올리기(); });

async function 계획내려받기() {
  if (!들어왔나()) { 계획카톡 = false; 계획그리기(); return; }
  try {
    const d = await (await fetch('/api/plan', {headers: {Accept: 'application/json'}})).json();
    if (d.잘못) return;
    계획카톡 = !!d.카톡;
    /* 🛑 서버 것이 비었다고 이 컴퓨터 것을 지우지 않는다 — 로그인 전에 적어 둔 계획이
       들어오는 순간 사라지면, 손님 눈에는 우리가 지운 것이다. 올려 준다. */
    if (Array.isArray(d.계획) && d.계획.length) {
      계획들 = d.계획.slice(0, 계획최대);
      try { localStorage.setItem('TF계획', JSON.stringify(계획들)); } catch (e) {}
    } else if (계획들.length) {
      계획올리기();
    }
    계획그리기();
  } catch (e) {}
}

/* 🔔 종 하나. 꺼져 있을 때는 **빗금**을 그어 "지금은 안 온다"를 그림으로 말한다.
   🛑 색은 여기서 정하지 않는다 — `currentColor` 로 두어야 단추가 색을 갈 때 같이 간다. */
function 종그림(켬) {
  return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
    ><path d="M18 8.6a6 6 0 1 0-12 0c0 5.6-2.1 7.4-2.1 7.4h16.2S18 14.2 18 8.6Z"/><path
      d="M13.7 19.8a2 2 0 0 1-3.4 0"/>${켬 ? '' : '<path d="M3.6 3.6l16.8 16.8"/>'}</svg>`;
}

function 계획보이기() {
  const 칸 = $('#계획칸');
  if (!칸) return;
  칸.style.display = (지금탭 === '항공권' && !줄들.length) ? 'block' : 'none';
}

const 계획곳글 = c => c.도시 || c.나라 || '어디든지';
function 계획때글(c) {
  if (!c.시작) return '날짜 미정 · 여섯 달 안';
  const 박 = 날수(c.시작, c.끝 || c.시작);
  return `${짧은날(c.시작)} → ${짧은날(c.끝 || c.시작)}` + (박 ? ` · ${박}박` : '');
}

function 계획그리기() {
  const 방 = $('#계획들');
  if (!방) return;
  방.innerHTML = 계획들.map((c, i) => `
    <div class="계획">
      <button class="뺌" data-뺌="${i}" title="지우기" aria-label="계획 지우기">✕</button>
      <button class="속" data-고침="${i}">
        <span class="곳">${홑(계획곳글(c))}${c.도시 && c.나라 ? `<em>${홑(c.나라)}</em>` : ''}</span>
        <span class="때">${홑(계획때글(c))}</span>
        ${c.알림 && +c.목표값 > 0
            ? `<span class="목표">🎯 ${홑(돈(+c.목표값))}원 이하면 알림</span>` : ''}
      </button>
      <button class="종단추${c.알림 ? ' 켬' : ''}" data-알림="${i}"
              aria-pressed="${c.알림 ? 'true' : 'false'}"
              title="${c.알림 ? '알림 끄기' : '알림 받기'}">${종그림(c.알림)}<span class="글">${
        c.알림 ? '알림 켜짐' : '알림 받기'}</span></button>
    </div>`).join('')
    + (계획들.length < 계획최대
        ? `<button class="계획더" data-고침="새">＋ 계획 추가</button>` : '');

  방.querySelectorAll('[data-고침]').forEach(b =>
    b.onclick = () => 계획열기(b.dataset.고침));
  방.querySelectorAll('[data-뺌]').forEach(b =>
    b.onclick = () => { 계획들.splice(+b.dataset.뺌, 1); 계획적기(); });
  방.querySelectorAll('[data-알림]').forEach(b =>
    b.onclick = () => { if (!계획들[+b.dataset.알림].알림) 딸랑울리기(b); 계획알림토글(+b.dataset.알림); });

  const 켠수 = 계획들.filter(c => c.알림).length;
  $('#계획말줄').innerHTML = !계획들.length
    ? '최대 3개까지 적어 두실 수 있습니다.'
    : (켠수
        ? `<span class="지켜">🔔 ${켠수}개 지켜보는 중</span> 값이 내려가면 카카오톡으로 알려드립니다.`
        : '종을 켜 두시면 값이 내려갈 때 카카오톡으로 알려드립니다.');
  계획보이기();
}

/* ─────────────────────────────────────────── 계획 하나 고치기 */

function 계획열기(어느) {
  if (!메타) return;
  계획고침 = (어느 === '새') ? -1 : +어느;
  const 옛 = (계획고침 >= 0) ? 계획들[계획고침] : null;
  계획중 = 옛 ? Object.assign({}, 옛)
              : {나라: '', 도시: '', 시작: '', 끝: '', 알림: false, 목표값: 0};
  if (!(+계획중.목표값 > 0)) 계획중.목표값 = 0;
  /* 🛑 서버(KV)에서 내려온 계획에는 `날짜없음` 딱지가 없다 — 흰 목록에 없는 칸이라
     조용히 떨어져 나간다. 날짜가 비어 있는 **적힌 계획**은 일부러 안 정한 것이다.
     새 계획은 아직 아무것도 안 정한 것이라 켜지 않는다. */
  계획중.날짜없음 = 옛 ? !계획중.시작 : false;
  $('#계획제목').textContent = 옛 ? '여행 계획 고치기' : '여행 계획';
  $('#계획지움').style.display = 옛 ? '' : 'none';
  계획창갱신();
  열기('계획덮개');
}

/* 나라 차례 — 지역 묶음 차례를 그대로 따른다 (실제로 많이 가는 순서다) */
function 계획나라들() {
  const 표 = {};
  (메타.목적지 || []).forEach(c => {
    if (!c.나라) return;
    (표[c.나라] = 표[c.나라] || {지역: c.지역, 도시: []}).도시.push(c.이름);
  });
  return Object.entries(표).sort((a, b) =>
    나라번호(a[1].지역) - 나라번호(b[1].지역) || a[0].localeCompare(b[0], 'ko'));
}

function 계획창갱신() {
  const 나라들 = 계획나라들();
  $('#계획나라칩').innerHTML = 나라들.map(([n]) =>
    `<button class="칩${n === 계획중.나라 ? ' 켬' : ''}" data-n="${홑(n)}">${홑(n)}</button>`).join('');
  $('#계획나라칩').querySelectorAll('.칩').forEach(b => b.onclick = () => {
    // 같은 나라를 또 누르면 끈다 — 고르는 자리는 늘 되돌릴 수 있어야 한다
    const 같나 = (b.dataset.n === 계획중.나라);
    계획중.나라 = 같나 ? '' : b.dataset.n;
    계획중.도시 = '';
    계획창갱신();
  });

  const 고른 = 나라들.find(([n]) => n === 계획중.나라);
  $('#계획도시줄').style.display = 고른 ? 'block' : 'none';
  if (고른) {
    $('#계획도시칩').innerHTML = 고른[1].도시.map(d =>
      `<button class="칩${d === 계획중.도시 ? ' 켬' : ''}" data-d="${홑(d)}">${홑(d)}</button>`).join('');
    $('#계획도시칩').querySelectorAll('.칩').forEach(b => b.onclick = () => {
      계획중.도시 = (b.dataset.d === 계획중.도시) ? '' : b.dataset.d;
      계획창갱신();
    });
  }

  /* 🗓 날짜 — 「안 정함」이면 달력 칸은 흐려지고, 무엇으로 대신하는지 글로 적는다.
     🛑 흐리게만 두고 글을 안 바꾸면 손님은 [날짜 고르기] 가 고장 난 줄 안다. */
  const 날없 = !!계획중.날짜없음;
  $('#계획날글').textContent = 날없 ? '여섯 달 안 아무 때나'
    : 계획중.시작 ? `${짧은날(계획중.시작)} → ${짧은날(계획중.끝 || 계획중.시작)}`
    : '날짜 고르기';
  $('#계획날칸').disabled = 날없;
  const 날단 = $('#계획날없음');
  날단.className = '날없음' + (날없 ? ' 켬' : '');
  날단.setAttribute('aria-pressed', 날없 ? 'true' : 'false');

  /* 🔔 종과 🎯 목표값 — 종이 꺼져 있으면 목표값 칸 자체를 감춘다.
     안 감추면 "안 켰는데 얼마 이하?" 라는 물음을 손님이 풀어야 한다. */
  const 종 = $('#계획종');
  종.className = '종단추' + (계획중.알림 ? ' 켬' : '');
  종.setAttribute('aria-pressed', 계획중.알림 ? 'true' : 'false');
  $('#계획종그림').innerHTML = 종그림(계획중.알림);
  종.querySelector('.글').textContent = 계획중.알림 ? '알림 켜짐' : '알림 받기';
  $('#계획값줄').style.display = 계획중.알림 ? 'block' : 'none';
  계획값그리기();

  /* 🛑 날짜를 안 정하기로 **고른** 것과 아직 아무것도 안 고른 것은 다르다.
     후자는 그대로 막는다 — 안 그러면 실수로 빈 계획이 저장된다. */
  const 됨 = !!(계획중.나라 && (날없 || (계획중.시작 && 계획중.끝)));
  const 때말 = 날없 ? '앞으로 여섯 달 안에 ' : '';
  $('#계획확인').disabled = !됨;
  $('#계획도움').textContent =
      !계획중.나라 ? '나라를 골라 주세요'
    : (!날없 && !계획중.시작) ? '언제 가실지 골라 주세요 — 아직이시면 [날짜 지정 안 함]'
    : !계획중.알림 ? (날없 ? '날짜는 나중에 고치셔도 됩니다.' : '')
    : (+계획중.목표값 > 0)
        ? `${때말}${돈(+계획중.목표값)}원 이하로 잡힐 때마다 카카오톡으로 알려드립니다.`
        : `${때말}값이 평소보다 많이 내려가면 카카오톡으로 알려드립니다.`;
}

/* 🎯 「얼마 이하면 알려 줘」 — 손님이 제일 잘 아는 건 **자기 예산**이지 할인율이 아니다.
   🛑 손잡이는 0 자리에 못 세운다. 「안 정함」은 자 위의 한 칸이 아니라 **딴 상태**라서,
      끌다가 실수로 알림을 통째로 끄는 일이 없게 단추를 따로 뒀다. */
const 목표값기본 = 500000;

function 계획값그리기() {
  const 자 = $('#계획값자');
  const 칸 = $('#계획값고르기');
  if (!자 || !칸 || !계획중) return;
  const 정함 = +(계획중.목표값 || 0) > 0;
  /* 안 정했어도 손잡이는 **쓸 만한 자리**에 세워 둔다 — 끌기 시작할 곳이 있어야 한다.
     🛑 [안 정함] 을 눌렀다고 손잡이가 처음 자리로 튀면 안 된다. 방금 80만원에 두고
        껐다 켜면 80만원이 그대로 있어야 한다. */
  const 값 = Math.min(+자.max, Math.max(+자.min,
      정함 ? +계획중.목표값 : (+자.value || 목표값기본)));
  자.value = 값;
  자.style.setProperty('--찬', ((값 - +자.min) / (+자.max - +자.min) * 100).toFixed(1) + '%');
  칸.classList.toggle('안정함', !정함);
  $('#계획값글').textContent = 정함 ? (값 / 10000) + '만원' : '값은 안 정함';
  $('#계획값꼬리').textContent = 정함 ? '이하면 알림' : '— 평소보다 내려가면 알림';
  $('#계획값안정').classList.toggle('켬', !정함);
}

/* 끌면 그 순간 정해진다 — 「안 정함」이었어도 끌었다는 건 정하겠다는 뜻이다 */
function 계획값끌기() {
  if (!계획중) return;
  계획중.목표값 = +$('#계획값자').value;
  계획창갱신();
}

function 계획값안정함() {
  if (!계획중) return;
  계획중.목표값 = (+계획중.목표값 > 0) ? 0 : (+$('#계획값자').value || 목표값기본);
  계획창갱신();
}

/* 계획 창의 종 — 여기서는 **고르기만** 한다. 카카오 동의 창은 [저장] 을 누른 뒤에 뜬다
   (아직 저장도 안 한 계획 때문에 남의 로그인 창이 뜨면 손님은 무슨 일인지 모른다). */
function 계획종누름() {
  if (!계획중) return;
  계획중.알림 = !계획중.알림;
  계획창갱신();                       // 🛑 먼저 그리고 나서 흔든다 — 순서가 바뀌면 딸랑이 지워진다
  if (계획중.알림) 딸랑울리기($('#계획종'));
}

function 딸랑울리기(단) {
  if (!단) return;
  단.classList.add('딸랑');
  setTimeout(() => 단.classList.remove('딸랑'), 620);
}

function 계획날고르기() { 달력열기('계획'); }

/* 🗓 [날짜 지정 안 함] — 켜면 날짜를 비운다. **빈 날짜가 곧 「여섯 달 아무 때나」** 다.
   🛑 화면에서만 비우면 안 된다. 같은 뜻으로 읽는 자리가 셋 더 있다 —
      `functions/api/plan.js`(저장) · `functions/api/alert.js`(추리기) · `트립핏공장.py`(뽑기).
      한 군데라도 옛 규칙이면 손님은 켰는데 카톡이 영영 안 온다. */
function 계획날없음누름() {
  if (!계획중) return;
  계획중.날짜없음 = !계획중.날짜없음;
  if (계획중.날짜없음) { 계획중.시작 = ''; 계획중.끝 = ''; }
  계획창갱신();
}

function 계획저장() {
  if (!계획중 || !계획중.나라) return;
  if (!계획중.날짜없음 && (!계획중.시작 || !계획중.끝)) return;
  /* 🛑 「안 정함」인데 옛 날짜가 남아 있으면 서버는 그 날짜로 알림을 보낸다 */
  if (계획중.날짜없음) { 계획중.시작 = ''; 계획중.끝 = ''; }
  /* 🛑 종을 껐으면 목표값도 같이 지운다. 남겨 두면 다음에 종만 켰을 때, 손님이
     기억도 못 하는 **옛 목표값**으로 카톡이 간다. */
  계획중.목표값 = 계획중.알림 ? (+계획중.목표값 || 0) : 0;
  const 것 = Object.assign({}, 계획중);
  if (계획고침 >= 0) 계획들[계획고침] = 것;
  else 계획들.push(것);
  닫기('계획덮개');
  계획적기();
  /* 알림을 켠 채로 저장했으면 그 자리에서 문을 연다 — 저장만 되고 알림이 안 가면
     손님은 켠 줄 알고 기다린다 (그게 제일 나쁘다). */
  if (것.알림) 계획알림켜기(계획들.indexOf(것));
}

function 계획지우기() {
  if (계획고침 < 0) { 닫기('계획덮개'); return; }
  계획들.splice(계획고침, 1);
  닫기('계획덮개');
  계획적기();
}

/* ─────────────────────────────────────────── 🔔 알림 */

function 계획알림토글(i) {
  const c = 계획들[i];
  if (!c) return;
  if (c.알림) { c.알림 = false; 계획적기(); return; }
  계획알림켜기(i);
}

async function 계획알림켜기(i) {
  if (!계획들[i]) return;
  const 됨 = await 카톡문();
  /* 🛑 카톡문() 안에서 계획내려받기() 가 **계획들을 통째로 갈아 끼울 수 있다.**
     기다리기 전에 잡아 둔 것에 적으면, 그 딱지는 버려진 옛 배열에 붙어 사라진다 —
     손님 눈에는 "켰는데 안 켜진다" 로 보인다. 기다린 뒤에 **자리로 다시 집는다.** */
  const c = 계획들[i];
  if (!c) return;
  c.알림 = 됨;
  계획적기();
}

/* 카톡으로 알려드리려면 두 가지가 필요하다 — ① 누구인지 ② 카톡 보내도 된다는 허락 */
async function 카톡문() {
  if (!로그인있나()) {
    쪽지띄우기('알림은 tripfit.pages.dev 에서 켜실 수 있습니다');
    return false;
  }
  if (!문열렸나()) {
    쪽지띄우기('카카오 로그인이 아직 안 켜져 있어 알림을 켤 수 없습니다');
    return false;
  }
  if (!들어왔나()) {
    트립핏.로그인문('🔔 값이 내려가면 알려드리려고요');
    return false;
  }
  if (계획카톡) return true;
  return 카톡허락받기();
}

/* 카카오 [메시지 보내기] 추가 동의. 로그인과 **같은 요령**이다 — 작은 창만 다녀오고
   보던 화면은 손도 안 댄다. 🛑 팝업이 막힌 브라우저면 화면째 다녀온다. */
function 카톡허락받기() {
  return new Promise(끝 => {
    /* 🛑 묶어 둔 저장이 남아 있는 채로 창을 다녀오면, 돌아와서 내려받은 **옛 계획**이
       방금 적은 것을 덮는다. 나가기 전에 밀린 것을 먼저 올린다. */
    계획정말올리기();
    const 돌아갈 = location.pathname + location.search + location.hash;
    const 앞 = '/api/login/kakao?동의=talk&돌아갈=' + encodeURIComponent(돌아갈);
    let w = null;
    try { w = window.open(앞 + '&팝업=1', 'tripfit카톡', 'width=520,height=640'); }
    catch (e) { w = null; }
    if (!w) { location.href = 앞; 끝(false); return; }
    const 지켜 = setInterval(async () => {
      if (!w.closed) return;
      clearInterval(지켜);
      await 계획내려받기();
      if (!계획카톡) 쪽지띄우기('카카오톡으로 보내도 된다는 동의가 필요합니다');
      끝(계획카톡);
    }, 500);
  });
}

/* 작은 쪽지 하나. 🛑 로그인.js·보고.js 는 손님용 사이트에만 붙는다 —
   8773 에서도 말이 나와야 하므로 화면이 제 것을 하나 갖는다. */
function 쪽지띄우기(말) {
  const t = document.createElement('div');
  t.setAttribute('style',
    'position:fixed;right:16px;bottom:74px;z-index:9100;background:var(--브랜드);color:#fff;'
    + 'padding:11px 15px;border-radius:11px;font-size:13px;font-weight:700;'
    + 'box-shadow:0 10px 26px rgba(0,0,0,.2);max-width:280px');
  t.textContent = 말;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 3200);
}

/* ═══════════════════════════════════════════ ◀ 브라우저 뒤로 가기 = 전 단계
   🛑 8/12 대표: 항공권 → 숙박으로 넘어온 뒤 ← 를 눌렀더니 전 탭이 아니라
      **트립핏을 통째로 나가 구글 첫 화면**이 떴다. 이 화면은 한 페이지에서
      display 만 갈아 끼우는 구조라, 탭을 열 번 옮겨도 히스토리는 한 칸뿐이었다.
      브라우저가 보기엔 "들어와서 아무 데도 안 간 페이지"라 ← 는 사이트 밖이 맞다.
   ⭐ 고침 = 화면이 바뀔 때마다 자리를 쌓는다. 탭은 #숙박 처럼 해시를 남기고,
      창(덮개)은 해시 없이 자리만 쌓아 ← 한 번에 창만 닫히게 한다.
   🛑 되그리는 중에는 자리되돌림 = true — 안 걸면 뒤로 갈 때마다 또 쌓여 무한이 된다. */
let 자리되돌림 = false;
function 자리쌓기(자리) {
  // 🛑 창은 주소를 건드리지 않는다 — url 에 null 을 주면 지금 주소가 그대로 유지된다.
  //    빈 문자열('')을 주면 브라우저마다 다르게 해석해 주소가 흔들린다.
  try { history.pushState(자리, '', 자리.곳 === '탭' ? '#' + 자리.탭 : null); }
  catch (e) {}
}
function 자리고쳐쌓기() {                    // 지금 보고 있는 자리로 '첫 칸'을 채운다
  try { history.replaceState({곳: '탭', 탭: 지금탭}, '', '#' + 지금탭); } catch (e) {}
}
addEventListener('popstate', e => {
  const s = e.state || {곳: '탭', 탭: 지금탭};
  /* 창이 떠 있으면 ← 는 '창 닫기'다. s 가 창이면 그 창만 남기고 나머지를 닫는다 */
  document.querySelectorAll('.덮개.켬').forEach(d => {
    if (s.곳 !== '창' || d.id !== s.id) d.classList.remove('켬');
  });
  if (s.곳 === '창') { const d = $('#' + s.id); if (d) d.classList.add('켬'); }
  const 갈탭 = s.탭 || 지금탭;
  if (갈탭 !== 지금탭) {
    자리되돌림 = true;
    try { 탭보이기(갈탭); } finally { 자리되돌림 = false; }
  }
});

/* ─────────────────────────────────────────── 덮개
   🛑 창은 열 때 자리를 쌓고, 닫을 때 그 자리를 도로 물린다(history.back()).
      실제로 닫는 일은 popstate 한 곳에서만 한다 — ← 로 닫든 ×로 닫든 같은 길이다. */
function 열기(id) {
  const d = $('#' + id);
  if (!d || d.classList.contains('켬')) return;
  d.classList.add('켬');
  자리쌓기({곳: '창', id: id, 탭: 지금탭});
}
function 닫기(id) {
  const d = $('#' + id);
  if (!d || !d.classList.contains('켬')) return;
  if ((history.state || {}).곳 === '창' && history.state.id === id) { history.back(); return; }
  d.classList.remove('켬');                  // 자리가 어긋났으면 화면만이라도 닫는다
}
document.querySelectorAll('.덮개').forEach(d =>
  d.addEventListener('click', e => { if (e.target === d) 닫기(d.id); }));
addEventListener('keydown', e => {
  if (e.key !== 'Escape') return;
  const 창 = [...document.querySelectorAll('.덮개.켬')].pop();
  if (창) 닫기(창.id);
});

/* 첫자리잡기 — 🛑 첫 칸에 이름표부터 단다. 안 달면 맨 앞으로 돌아왔을 때 state 가 null 이라
   어느 탭이었는지 모른다. 🛑 이때 들어온 해시(#숙박)를 먼저 읽어야 한다 —
   덮어쓰고 나서 읽으면 새로고침할 때마다 항공권으로 되돌아간다(한 번 당했다). */
const 들어온탭 = decodeURIComponent((location.hash || '').slice(1));
if (탭들.some(([, v]) => v === 들어온탭)) 지금탭 = 들어온탭;
자리고쳐쌓기();
시작();
</script>
</body>
</html>
